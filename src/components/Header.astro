---
import { SITE } from '@/config/site';
import { mainNav } from '@/config/nav';
import ThemeToggle from './ThemeToggle.astro';

const pathname = Astro.url.pathname;
---

<header class="relative z-40 border-b border-[var(--color-line)]/70 bg-[var(--color-canvas)]/85 backdrop-blur-md dark:border-[var(--color-dark-line)]/80 dark:bg-[var(--color-dark-canvas)]/85">
  <div class="mx-auto flex max-w-5xl items-center justify-between gap-4 px-5 py-4 sm:px-8">
    <a
      href="/"
      class="font-display text-xl font-semibold tracking-tight text-[var(--color-pine)] transition hover:text-[var(--color-clay)] dark:text-[var(--color-dark-pine)] dark:hover:text-[var(--color-dark-clay)] sm:text-2xl"
    >
      {SITE.name}
    </a>

    <nav class="hidden items-center gap-1 md:flex" aria-label="Primary">
      {
        mainNav.map((item) => {
          const active = pathname === item.href || pathname.startsWith(`${item.href}/`);
          return (
            <a
              href={item.href}
              class:list={[
                'rounded-md px-3 py-2 text-sm font-medium transition',
                active
                  ? 'text-[var(--color-pine)] dark:text-[var(--color-dark-pine)]'
                  : 'text-[var(--color-ink-muted)] hover:text-[var(--color-ink)] dark:text-[var(--color-dark-muted)] dark:hover:text-[var(--color-dark-ink)]',
              ]}
              aria-current={active ? 'page' : undefined}
            >
              {item.label}
            </a>
          );
        })
      }
      <div class="ml-2">
        <ThemeToggle />
      </div>
    </nav>

    <div class="flex items-center gap-2 md:hidden">
      <ThemeToggle />
      <button
        type="button"
        id="menu-toggle"
        class="inline-flex h-10 w-10 items-center justify-center rounded-md border border-[var(--color-line)] bg-[var(--color-canvas-elevated)] dark:border-[var(--color-dark-line)] dark:bg-[var(--color-dark-elevated)]"
        aria-expanded="false"
        aria-controls="mobile-nav"
        aria-label="Open menu"
      >
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
          <path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16" />
        </svg>
      </button>
    </div>
  </div>

  <nav
    id="mobile-nav"
    class="hidden border-t border-[var(--color-line)] px-5 py-3 dark:border-[var(--color-dark-line)] md:hidden"
    aria-label="Mobile"
  >
    <ul class="flex flex-col gap-1">
      {
        mainNav.map((item) => (
          <li>
            <a
              href={item.href}
              class="block rounded-md px-3 py-2.5 text-base font-medium text-[var(--color-ink)] dark:text-[var(--color-dark-ink)]"
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const panel = document.getElementById('mobile-nav');
  toggle?.addEventListener('click', () => {
    const open = panel?.classList.toggle('hidden') === false;
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
  });
</script>
