---
import { SITE, NEWSLETTER_URL } from '@/config/site';
import { mainNav } from '@/config/nav';
import { brandShortLinks } from '@/config/social';
import SocialLinks from './SocialLinks.astro';

const year = new Date().getFullYear();
---

<footer class="mt-auto border-t border-[var(--color-line)] bg-[var(--color-hero)] text-[var(--color-hero-ink)] dark:border-[var(--color-dark-line)]">
  <div class="site-shell grid gap-10 py-14 md:grid-cols-[1.4fr_1fr_1fr]">
    <div>
      <p class="font-display text-2xl font-semibold">{SITE.name}</p>
      <p class="mt-3 max-w-sm text-sm leading-relaxed text-[var(--color-hero-muted)]">
        {SITE.tagline} Based in {SITE.location}. Also found near rivers and half-finished dinner plans.
      </p>
      <p class="mt-5">
        <a
          href={NEWSLETTER_URL}
          class="inline-flex items-center gap-2 text-sm font-semibold text-white underline-offset-4 hover:underline"
        >
          Get the Gathered newsletter
          <span aria-hidden="true">→</span>
        </a>
      </p>
    </div>

    <div>
      <p class="text-xs font-semibold uppercase tracking-[0.14em] text-white/45">Explore</p>
      <ul class="mt-4 space-y-2 text-sm">
        {
          mainNav.map((item) => (
            <li>
              <a href={item.href} class="text-white/80 transition hover:text-white">
                {item.label}
              </a>
            </li>
          ))
        }
        <li>
          <a href="/rss.xml" class="text-white/80 transition hover:text-white">RSS</a>
        </li>
      </ul>
    </div>

    <div>
      <p class="text-xs font-semibold uppercase tracking-[0.14em] text-white/45">Say hello</p>
      <ul class="mt-4 space-y-2 text-sm">
        <li>
          <a href="/contact" class="text-white/80 transition hover:text-white">Contact form</a>
        </li>
        <li>
          <a href="/speaking" class="text-white/80 transition hover:text-white">Speaking</a>
        </li>
        {
          brandShortLinks.map((link) => (
            <li>
              <a href={link.href} class="text-white/80 transition hover:text-white" rel="noopener noreferrer">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
      <div class="mt-5">
        <SocialLinks onDark />
      </div>
    </div>
  </div>

  <div class="border-t border-white/10">
    <p class="site-shell py-5 text-xs text-white/40">
      © {year} {SITE.name}. Built for clarity, not clutter. Leave room for the river.
    </p>
  </div>
</footer>
