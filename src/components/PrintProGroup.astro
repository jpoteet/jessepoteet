---
import { printProStrategies } from '@/config/brands';
import type { PrintProChild } from '@/config/brands';

interface Props {
  /** Tighter layout for the homepage brands section. */
  compact?: boolean;
}

const { compact = false } = Astro.props;
const parent = printProStrategies;

function childLink(child: PrintProChild) {
  return child.url;
}
---

<section
  id="printpro"
  class:list={[
    'scroll-mt-24',
    compact
      ? 'border-t border-[var(--color-line)] pt-8 dark:border-[var(--color-dark-line)]'
      : 'pt-2',
  ]}
  aria-labelledby="printpro-heading"
>
  <div class="flex items-start gap-4">
    <div
      class="flex h-12 w-12 shrink-0 items-center justify-center rounded-md bg-[var(--color-pine)] font-display text-sm font-semibold tracking-wide text-[var(--color-canvas)] dark:bg-[var(--color-dark-pine)] dark:text-[var(--color-dark-canvas)]"
      aria-hidden="true"
      data-logo-path={parent.logoPath}
      title={`Logo placeholder. Drop file at public${parent.logoPath}`}
    >
      {parent.monogram}
    </div>
    <div class="min-w-0">
      <h3 id="printpro-heading" class="font-display text-2xl font-semibold sm:text-3xl">
        {parent.name}
      </h3>
      <p class="mt-1 text-xs font-medium uppercase tracking-[0.12em] text-[var(--color-sage)] dark:text-[var(--color-dark-muted)]">
        {parent.legalName}
      </p>
      <p class="mt-3 max-w-2xl text-base leading-relaxed text-[var(--color-ink-muted)] dark:text-[var(--color-dark-muted)]">
        <span class="font-semibold text-[var(--color-ink)] dark:text-[var(--color-dark-ink)]">Problem:</span> {parent.problem}
      </p>
      <p class="mt-2 max-w-2xl text-sm text-[var(--color-ink-muted)] dark:text-[var(--color-dark-muted)]">
        {parent.blurb}
        {
          parent.url ? null : (
            <span class="mt-1 block text-sm opacity-80">{parent.urlTodo}</span>
          )
        }
      </p>
    </div>
  </div>

  <div class:list={['mt-8 grid gap-8', compact ? 'lg:grid-cols-2' : 'lg:grid-cols-2']}>
    <div>
      <h4 class="text-xs font-semibold uppercase tracking-[0.14em] text-[var(--color-sage)] dark:text-[var(--color-dark-muted)]">
        Print education
      </h4>
      <ul class="mt-4 space-y-5">
        {
          parent.education.map((child) => {
            const href = childLink(child);
            return (
              <li class="border-t border-[var(--color-line)]/80 pt-4 dark:border-[var(--color-dark-line)]">
                <div class="flex items-baseline justify-between gap-3">
                  <p class="font-display text-lg font-semibold">
                    {href ? (
                      <a href={href} rel="noopener noreferrer" target="_blank" class="hover:text-[var(--color-clay)] dark:hover:text-[var(--color-dark-clay)]">
                        {child.name}
                      </a>
                    ) : (
                      child.name
                    )}
                  </p>
                  <span class="font-display text-xs font-semibold text-[var(--color-sage)]" aria-hidden="true">
                    {child.monogram}
                  </span>
                </div>
                <p class="mt-1 text-sm leading-relaxed text-[var(--color-ink-muted)] dark:text-[var(--color-dark-muted)]">
                  <span class="font-medium text-[var(--color-ink)] dark:text-[var(--color-dark-ink)]">Problem:</span> {child.problem}
                </p>
                {!href && child.urlTodo && (
                  <p class="mt-1 text-xs text-[var(--color-ink-muted)]/80 dark:text-[var(--color-dark-muted)]">{child.urlTodo}</p>
                )}
              </li>
            );
          })
        }
      </ul>
    </div>

    <div>
      <h4 class="text-xs font-semibold uppercase tracking-[0.14em] text-[var(--color-sage)] dark:text-[var(--color-dark-muted)]">
        Software
      </h4>
      <ul class="mt-4 space-y-5">
        {
          parent.software.map((child) => {
            const href = childLink(child);
            return (
              <li class="border-t border-[var(--color-line)]/80 pt-4 dark:border-[var(--color-dark-line)]">
                <div class="flex items-baseline justify-between gap-3">
                  <p class="font-display text-lg font-semibold">
                    {href ? (
                      <a href={href} rel="noopener noreferrer" target="_blank" class="hover:text-[var(--color-clay)] dark:hover:text-[var(--color-dark-clay)]">
                        {child.name}
                      </a>
                    ) : (
                      child.name
                    )}
                  </p>
                  <span class="font-display text-xs font-semibold text-[var(--color-sage)]" aria-hidden="true">
                    {child.monogram}
                  </span>
                </div>
                <p class="mt-1 text-sm leading-relaxed text-[var(--color-ink-muted)] dark:text-[var(--color-dark-muted)]">
                  <span class="font-medium text-[var(--color-ink)] dark:text-[var(--color-dark-ink)]">Problem:</span> {child.problem}
                </p>
              </li>
            );
          })
        }
      </ul>
    </div>
  </div>
</section>
