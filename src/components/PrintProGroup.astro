---
import { printProStrategies } from '@/config/brands';
import type { PrintProChild } from '@/config/brands';

interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
const parent = printProStrategies;

function childLink(child: PrintProChild) {
  return child.url;
}
---

<section
  id="printpro"
  class:list={['scroll-mt-24', compact ? 'border-t border-[var(--color-line)] pt-8 dark:border-[var(--color-dark-line)]' : 'pt-2']}
  aria-labelledby="printpro-heading"
>
  <div class="flex items-start gap-4">
    <div
      class="flex h-12 w-12 shrink-0 items-center justify-center rounded-md bg-[var(--color-accent)] font-display text-sm font-semibold tracking-wide text-white dark:bg-[var(--color-dark-accent)] dark:text-[var(--color-dark-canvas)]"
      aria-hidden="true"
    >
      {parent.monogram}
    </div>
    <div class="min-w-0">
      <h3 id="printpro-heading" class="font-display text-2xl font-semibold sm:text-3xl">
        {parent.name}
      </h3>
      <p class="mt-1 text-xs font-medium uppercase tracking-[0.12em] text-[var(--color-ink-muted)] dark:text-[var(--color-dark-muted)]">
        {parent.legalName}
      </p>
      <p class="mt-3 max-w-2xl text-base leading-relaxed text-[var(--color-ink-muted)] dark:text-[var(--color-dark-muted)]">
        <span class="font-semibold text-[var(--color-ink)] dark:text-[var(--color-dark-ink)]">Problem:</span> {parent.problem}
      </p>
      <p class="mt-2 max-w-2xl text-sm text-[var(--color-ink-muted)] dark:text-[var(--color-dark-muted)]">
        {parent.blurb}
      </p>
    </div>
  </div>

  <div class="mt-8 grid gap-8 lg:grid-cols-2">
    <div>
      <h4 class="text-xs font-semibold uppercase tracking-[0.14em] text-[var(--color-ink-muted)] dark:text-[var(--color-dark-muted)]">
        Print education
      </h4>
      <ul class="mt-4 space-y-5">
        {
          parent.education.map((child) => {
            const href = childLink(child);
            return (
              <li class="border-t border-[var(--color-line)]/80 pt-4 dark:border-[var(--color-dark-line)]">
                <p class="font-display text-lg font-semibold">
                  {href ? (
                    <a href={href} rel="noopener noreferrer" target="_blank" class="hover:text-[var(--color-accent)] dark:hover:text-[var(--color-dark-accent)]">
                      {child.name}
                    </a>
                  ) : (
                    child.name
                  )}
                </p>
                <p class="mt-1 text-sm leading-relaxed text-[var(--color-ink-muted)] dark:text-[var(--color-dark-muted)]">
                  <span class="font-medium text-[var(--color-ink)] dark:text-[var(--color-dark-ink)]">Problem:</span> {child.problem}
                </p>
              </li>
            );
          })
        }
      </ul>
      {
        parent.educationAlso.length > 0 && (
          <p class="mt-5 text-sm text-[var(--color-ink-muted)] dark:text-[var(--color-dark-muted)]">
            Also under PrintPro Strategies: {parent.educationAlso.join(', ')}.
          </p>
        )
      }
    </div>

    <div>
      <h4 class="text-xs font-semibold uppercase tracking-[0.14em] text-[var(--color-ink-muted)] dark:text-[var(--color-dark-muted)]">
        Software
      </h4>
      <ul class="mt-4 space-y-5">
        {
          parent.software.map((child) => {
            const href = childLink(child);
            return (
              <li class="border-t border-[var(--color-line)]/80 pt-4 dark:border-[var(--color-dark-line)]">
                <p class="font-display text-lg font-semibold">
                  {href ? (
                    <a href={href} rel="noopener noreferrer" target="_blank" class="hover:text-[var(--color-accent)] dark:hover:text-[var(--color-dark-accent)]">
                      {child.name}
                    </a>
                  ) : (
                    child.name
                  )}
                </p>
                <p class="mt-1 text-sm leading-relaxed text-[var(--color-ink-muted)] dark:text-[var(--color-dark-muted)]">
                  {child.blurb}
                </p>
              </li>
            );
          })
        }
      </ul>
    </div>
  </div>
</section>
