---
import { socialLinks } from '@/config/social';

interface Props {
  class?: string;
  onDark?: boolean;
}

const { class: className = '', onDark = false } = Astro.props;
---

<ul class:list={['flex flex-wrap gap-x-4 gap-y-2 text-sm', className]}>
  {
    socialLinks.map((link) => (
      <li>
        <a
          href={link.href}
          rel="noopener noreferrer me"
          class:list={[
            'font-semibold underline-offset-4 transition hover:underline',
            onDark
              ? 'text-white/80 hover:text-white'
              : 'text-[var(--color-accent)] dark:text-[var(--color-dark-accent)]',
          ]}
        >
          {link.label}
        </a>
      </li>
    ))
  }
</ul>
