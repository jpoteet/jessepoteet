---
import { featuredAlpineStory } from '@/config/expertise';

const story = featuredAlpineStory;
---

<article class="panel overflow-hidden">
  <div class="border-b border-[var(--color-line)] px-6 py-6 sm:px-8 sm:py-8 dark:border-[var(--color-dark-line)]">
    <p class="eyebrow">{story.eyebrow}</p>
    <p class="mt-2 text-xs font-medium uppercase tracking-[0.12em] text-[var(--color-ink-muted)] dark:text-[var(--color-dark-muted)]">
      {story.name}
    </p>
    <h3 class="mt-3 font-display text-2xl font-semibold text-balance sm:text-3xl">
      {story.headline}
    </h3>
    <p class="mt-4 max-w-2xl text-[var(--color-ink-muted)] dark:text-[var(--color-dark-muted)]">
      {story.story}
    </p>
  </div>

  <dl class="grid gap-0 sm:grid-cols-3">
    <div class="border-b border-[var(--color-line)] px-6 py-5 sm:border-b-0 sm:border-r dark:border-[var(--color-dark-line)] sm:px-8">
      <dt class="text-xs font-semibold uppercase tracking-[0.12em] text-[var(--color-ink-muted)] dark:text-[var(--color-dark-muted)]">
        Problem
      </dt>
      <dd class="mt-2 text-sm leading-relaxed text-[var(--color-ink)] dark:text-[var(--color-dark-ink)]">
        {story.problem}
      </dd>
    </div>
    <div class="border-b border-[var(--color-line)] px-6 py-5 sm:border-b-0 sm:border-r dark:border-[var(--color-dark-line)] sm:px-8">
      <dt class="text-xs font-semibold uppercase tracking-[0.12em] text-[var(--color-ink-muted)] dark:text-[var(--color-dark-muted)]">
        What I built
      </dt>
      <dd class="mt-2 text-sm leading-relaxed text-[var(--color-ink)] dark:text-[var(--color-dark-ink)]">
        {story.built}
      </dd>
    </div>
    <div class="px-6 py-5 sm:px-8">
      <dt class="text-xs font-semibold uppercase tracking-[0.12em] text-[var(--color-ink-muted)] dark:text-[var(--color-dark-muted)]">
        Result
      </dt>
      <dd class="mt-2 text-sm leading-relaxed font-semibold text-[var(--color-ink)] dark:text-[var(--color-dark-ink)]">
        {story.result}
      </dd>
    </div>
  </dl>

  <div
    class="border-t border-[var(--color-line)] px-6 py-6 sm:px-8 dark:border-[var(--color-dark-line)]"
    role="img"
    aria-label="Visual comparison of quote effort before and after"
  >
    <div class="space-y-5">
      <div>
        <p class="mb-2 text-sm font-medium text-[var(--color-ink-muted)] dark:text-[var(--color-dark-muted)]">
          {story.beforeLabel}
        </p>
        <div class="h-2.5 overflow-hidden rounded-sm bg-[var(--color-line)] dark:bg-[var(--color-dark-line)]">
          <div
            class="h-full rounded-sm bg-[var(--color-ink-muted)] dark:bg-[var(--color-dark-muted)]"
            style={`width: ${story.beforeWidth}%`}
          >
          </div>
        </div>
      </div>
      <div>
        <p class="mb-2 text-sm font-medium text-[var(--color-ink-muted)] dark:text-[var(--color-dark-muted)]">
          {story.afterLabel}
        </p>
        <div class="h-2.5 overflow-hidden rounded-sm bg-[var(--color-line)] dark:bg-[var(--color-dark-line)]">
          <div
            class="h-full rounded-sm bg-[var(--color-accent)] dark:bg-[var(--color-dark-accent)]"
            style={`width: ${story.afterWidth}%`}
          >
          </div>
        </div>
      </div>
    </div>
  </div>
</article>
