---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import NewsletterCTA from '@/components/NewsletterCTA.astro';
import PhotoSlot from '@/components/PhotoSlot.astro';
import { SITE, NEWSLETTER_URL } from '@/config/site';
import {
  alpineApparel,
  alpineProof,
  beliefs,
  operatorStack,
  pressMentions,
  printProStrategies,
} from '@/config/brands';
import { workWithMePaths } from '@/config/contact';

const posts = (await getCollection('writing', ({ data }) => data.draft !== true))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<BaseLayout
  title="Home"
  description="Jesse Poteet helps owner-run businesses get off the treadmill. Designer, printer, and systems builder in Castle Rock, Colorado."
>
  <!-- 1. Hero: point of view + credibility -->
  <section class="mx-auto max-w-5xl px-5 pb-16 pt-14 sm:px-8 sm:pt-20">
    <div class="grid items-end gap-10 lg:grid-cols-[1.2fr_0.8fr]">
      <div class="fade-up">
        <p class="font-display text-3xl font-semibold tracking-tight text-[var(--color-pine)] dark:text-[var(--color-dark-pine)] sm:text-4xl md:text-5xl">
          {SITE.name}
        </p>
        <h1 class="mt-5 max-w-2xl text-balance text-2xl font-medium leading-snug text-[var(--color-ink)] dark:text-[var(--color-dark-ink)] sm:text-3xl md:text-[2rem] md:leading-snug">
          I help owner-run businesses get off the treadmill and back to building something that serves their family.
        </h1>
        <p class="mt-6 max-w-2xl text-base leading-relaxed text-[var(--color-ink-muted)] dark:text-[var(--color-dark-muted)] sm:text-lg">
          25+ years in graphic design. Running a print shop since 2013 (formerly Director of Art and Production at a commercial print shop). Enterprise marketing automation for brands like Qualcomm, CVS/Aetna, Honeywell, and Mastercard.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a
            href="#work-with-me"
            class="inline-flex items-center rounded-md bg-[var(--color-pine)] px-5 py-3 text-sm font-semibold text-white transition hover:bg-[var(--color-pine-deep)] dark:bg-[var(--color-dark-pine)] dark:text-[var(--color-dark-canvas)]"
          >
            Work with me
          </a>
          <a
            href="#building"
            class="inline-flex items-center rounded-md border border-[var(--color-line)] bg-[var(--color-canvas-elevated)] px-5 py-3 text-sm font-semibold text-[var(--color-ink)] transition hover:border-[var(--color-sage)] dark:border-[var(--color-dark-line)] dark:bg-[var(--color-dark-elevated)] dark:text-[var(--color-dark-ink)]"
          >
            What I am building
          </a>
        </div>
      </div>
      <div class="fade-up fade-up-delay-1">
        <PhotoSlot label="Jesse Poteet" src="/images/photos/jesse-hero.jpg" aspect="portrait" />
      </div>
    </div>
  </section>

  <div class="soft-divider mx-auto max-w-5xl"></div>

  <!-- 2. What I believe -->
  <section class="mx-auto max-w-5xl px-5 py-16 sm:px-8" aria-labelledby="believe-heading">
    <h2 id="believe-heading" class="font-display text-3xl font-semibold sm:text-4xl">What I believe</h2>
    <p class="mt-3 max-w-2xl text-[var(--color-ink-muted)] dark:text-[var(--color-dark-muted)]">
      A short filter for how I build companies and advise owners.
    </p>
    <ul class="mt-10 grid gap-8 sm:grid-cols-2">
      {
        beliefs.map((item) => (
          <li class="border-t border-[var(--color-line)] pt-5 dark:border-[var(--color-dark-line)]">
            <h3 class="font-display text-xl font-semibold">{item.title}</h3>
            <p class="mt-2 text-[var(--color-ink-muted)] dark:text-[var(--color-dark-muted)]">{item.body}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- 3. What I'm building -->
  <section id="building" class="scroll-mt-24 mx-auto max-w-5xl px-5 pb-16 sm:px-8" aria-labelledby="building-heading">
    <h2 id="building-heading" class="font-display text-3xl font-semibold sm:text-4xl">What I am building</h2>
    <p class="mt-3 max-w-2xl text-[var(--color-ink-muted)] dark:text-[var(--color-dark-muted)]">
      Not a link dump. Each brand exists because owners kept hitting the same wall.
    </p>

    <div class="mt-12 space-y-12">
      <article class="border-t border-[var(--color-line)] pt-8 dark:border-[var(--color-dark-line)]">
        <div class="flex items-start gap-4">
          <div
            class="flex h-12 w-12 shrink-0 items-center justify-center rounded-md bg-[var(--color-pine)] font-display text-sm font-semibold text-[var(--color-canvas)] dark:bg-[var(--color-dark-pine)] dark:text-[var(--color-dark-canvas)]"
            aria-hidden="true"
          >
            {printProStrategies.monogram}
          </div>
          <div>
            <h3 class="font-display text-2xl font-semibold">{printProStrategies.name}</h3>
            <p class="mt-1 text-xs font-medium uppercase tracking-[0.12em] text-[var(--color-sage)] dark:text-[var(--color-dark-muted)]">
              {printProStrategies.legalName}
            </p>
            <p class="mt-3 max-w-2xl text-[var(--color-ink-muted)] dark:text-[var(--color-dark-muted)]">
              <span class="font-semibold text-[var(--color-ink)] dark:text-[var(--color-dark-ink)]">Problem:</span>
              {' '}{printProStrategies.problem}
            </p>
          </div>
        </div>

        <div class="mt-8 grid gap-8 lg:grid-cols-2">
          <div>
            <h4 class="text-xs font-semibold uppercase tracking-[0.14em] text-[var(--color-sage)] dark:text-[var(--color-dark-muted)]">
              Education
            </h4>
            <ul class="mt-4 space-y-4">
              {
                printProStrategies.education.map((child) => (
                  <li class="border-t border-[var(--color-line)]/80 pt-4 dark:border-[var(--color-dark-line)]">
                    <p class="font-display text-lg font-semibold">
                      {child.url ? (
                        <a href={child.url} rel="noopener noreferrer" target="_blank" class="hover:text-[var(--color-clay)] dark:hover:text-[var(--color-dark-clay)]">
                          {child.name}
                        </a>
                      ) : (
                        child.name
                      )}
                    </p>
                    <p class="mt-1 text-sm text-[var(--color-ink-muted)] dark:text-[var(--color-dark-muted)]">
                      <span class="font-medium text-[var(--color-ink)] dark:text-[var(--color-dark-ink)]">Problem:</span> {child.problem}
                    </p>
                  </li>
                ))
              }
            </ul>
          </div>
          <div>
            <h4 class="text-xs font-semibold uppercase tracking-[0.14em] text-[var(--color-sage)] dark:text-[var(--color-dark-muted)]">
              Software
            </h4>
            <ul class="mt-4 space-y-4">
              {
                printProStrategies.software.map((child) => (
                  <li class="border-t border-[var(--color-line)]/80 pt-4 dark:border-[var(--color-dark-line)]">
                    <p class="font-display text-lg font-semibold">
                      {child.url ? (
                        <a href={child.url} rel="noopener noreferrer" target="_blank" class="hover:text-[var(--color-clay)] dark:hover:text-[var(--color-dark-clay)]">
                          {child.name}
                        </a>
                      ) : (
                        child.name
                      )}
                    </p>
                    <p class="mt-1 text-sm text-[var(--color-ink-muted)] dark:text-[var(--color-dark-muted)]">
                      <span class="font-medium text-[var(--color-ink)] dark:text-[var(--color-dark-ink)]">Problem:</span> {child.problem}
                    </p>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </article>

      <div class="grid gap-10 sm:grid-cols-2">
        {
          [alpineApparel, operatorStack].map((brand) => (
            <article class="border-t border-[var(--color-line)] pt-6 dark:border-[var(--color-dark-line)]">
              <div class="flex items-start gap-4">
                <div
                  class="flex h-12 w-12 shrink-0 items-center justify-center rounded-md bg-[var(--color-pine)] font-display text-sm font-semibold text-[var(--color-canvas)] dark:bg-[var(--color-dark-pine)] dark:text-[var(--color-dark-canvas)]"
                  aria-hidden="true"
                >
                  {brand.monogram}
                </div>
                <div>
                  <h3 class="font-display text-2xl font-semibold">
                    {brand.url ? (
                      <a href={brand.url} rel="noopener noreferrer" target="_blank" class="hover:text-[var(--color-clay)] dark:hover:text-[var(--color-dark-clay)]">
                        {brand.name}
                      </a>
                    ) : (
                      brand.name
                    )}
                  </h3>
                  <p class="mt-3 text-[var(--color-ink-muted)] dark:text-[var(--color-dark-muted)]">
                    <span class="font-semibold text-[var(--color-ink)] dark:text-[var(--color-dark-ink)]">Problem:</span> {brand.problem}
                  </p>
                  <p class="mt-2 text-sm text-[var(--color-ink-muted)] dark:text-[var(--color-dark-muted)]">{brand.blurb}</p>
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </div>

    <p class="mt-8">
      <a href="/work" class="text-sm font-semibold text-[var(--color-clay)] dark:text-[var(--color-dark-clay)]">
        Full ventures map →
      </a>
    </p>
  </section>

  <div class="soft-divider mx-auto max-w-5xl"></div>

  <!-- 4. Proof -->
  <section class="mx-auto max-w-5xl px-5 py-16 sm:px-8" aria-labelledby="proof-heading">
    <h2 id="proof-heading" class="font-display text-3xl font-semibold sm:text-4xl">Proof</h2>
    <div class="mt-10 grid gap-10 lg:grid-cols-[1fr_1.1fr]">
      <div class="border-t border-[var(--color-line)] pt-6 dark:border-[var(--color-dark-line)]">
        <h3 class="text-xs font-semibold uppercase tracking-[0.14em] text-[var(--color-sage)] dark:text-[var(--color-dark-muted)]">
          As featured in
        </h3>
        <ul class="mt-5 space-y-4">
          {
            pressMentions.map((item) => (
              <li class="flex items-center gap-4">
                <div class="flex h-12 w-28 items-center justify-center rounded-md border border-dashed border-[var(--color-sage)]/50 bg-[var(--color-canvas-elevated)] px-2 text-center text-xs font-semibold text-[var(--color-ink-muted)] dark:border-[var(--color-dark-muted)]/40 dark:bg-[var(--color-dark-elevated)] dark:text-[var(--color-dark-muted)]">
                  {item.name}
                </div>
                <div>
                  {item.href ? (
                    <a href={item.href} class="font-semibold text-[var(--color-clay)] dark:text-[var(--color-dark-clay)]" rel="noopener noreferrer">
                      {item.name}
                    </a>
                  ) : (
                    <p class="font-semibold">{item.name}</p>
                  )}
                  <p class="text-xs text-[var(--color-ink-muted)] dark:text-[var(--color-dark-muted)]">{item.todo}</p>
                </div>
              </li>
            ))
          }
        </ul>
      </div>
      <blockquote class="border-t border-[var(--color-line)] pt-6 dark:border-[var(--color-dark-line)]">
        <p class="font-display text-2xl font-semibold text-balance sm:text-3xl">{alpineProof.headline}</p>
        <p class="mt-4 text-[var(--color-ink-muted)] dark:text-[var(--color-dark-muted)]">{alpineProof.detail}</p>
        <p class="mt-3 text-sm font-medium text-[var(--color-sage)] dark:text-[var(--color-dark-muted)]">
          Alpine Apparel Co
        </p>
      </blockquote>
    </div>
  </section>

  <!-- 5. Ideas -->
  <section class="mx-auto max-w-5xl px-5 pb-16 sm:px-8" aria-labelledby="ideas-heading">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <h2 id="ideas-heading" class="font-display text-3xl font-semibold">Ideas</h2>
        <p class="mt-2 text-[var(--color-ink-muted)] dark:text-[var(--color-dark-muted)]">
          Latest writing here. Videos live on Startup Screen Printing for now.
        </p>
      </div>
      <a href="/writing" class="text-sm font-semibold text-[var(--color-clay)] dark:text-[var(--color-dark-clay)]">
        All writing →
      </a>
    </div>
    <ul class="mt-8 space-y-5">
      {
        posts.map((post) => (
          <li class="border-t border-[var(--color-line)] pt-5 dark:border-[var(--color-dark-line)]">
            <a href={`/writing/${post.id}/`} class="group block">
              <time
                datetime={post.data.pubDate.toISOString()}
                class="text-xs font-medium uppercase tracking-[0.12em] text-[var(--color-sage)] dark:text-[var(--color-dark-muted)]"
              >
                {post.data.pubDate.toLocaleDateString('en-US', {
                  year: 'numeric',
                  month: 'long',
                  day: 'numeric',
                })}
              </time>
              <h3 class="mt-2 font-display text-xl font-semibold group-hover:text-[var(--color-clay)] dark:group-hover:text-[var(--color-dark-clay)]">
                {post.data.title}
              </h3>
              <p class="mt-1 text-sm text-[var(--color-ink-muted)] dark:text-[var(--color-dark-muted)]">
                {post.data.description}
              </p>
            </a>
          </li>
        ))
      }
    </ul>
    <p class="mt-6 text-sm text-[var(--color-ink-muted)] dark:text-[var(--color-dark-muted)]">
      Videos:
      <a class="font-semibold text-[var(--color-clay)] dark:text-[var(--color-dark-clay)]" href="https://startupscreenprinting.com" rel="noopener noreferrer">
        startupscreenprinting.com
      </a>
      · <span class="opacity-70">[JESSE: featured video links]</span>
    </p>
  </section>

  <!-- 6. Work with me -->
  <section id="work-with-me" class="scroll-mt-24 mx-auto max-w-5xl px-5 pb-16 sm:px-8" aria-labelledby="wwm-heading">
    <h2 id="wwm-heading" class="font-display text-3xl font-semibold sm:text-4xl">Work with me</h2>
    <p class="mt-3 max-w-2xl text-[var(--color-ink-muted)] dark:text-[var(--color-dark-muted)]">
      Three clear doors. Pick the one that fits.
    </p>
    <ol class="mt-10 grid gap-8 md:grid-cols-3">
      {
        workWithMePaths.map((path, index) => (
          <li class="border-t border-[var(--color-line)] pt-5 dark:border-[var(--color-dark-line)]">
            <p class="text-xs font-semibold uppercase tracking-[0.14em] text-[var(--color-sage)] dark:text-[var(--color-dark-muted)]">
              {String(index + 1).padStart(2, '0')}
            </p>
            <h3 class="mt-3 font-display text-xl font-semibold">{path.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-[var(--color-ink-muted)] dark:text-[var(--color-dark-muted)]">
              {path.description}
            </p>
            <a
              href={path.href}
              class="mt-4 inline-flex text-sm font-semibold text-[var(--color-clay)] dark:text-[var(--color-dark-clay)]"
              rel={'external' in path && path.external ? 'noopener noreferrer' : undefined}
            >
              {path.cta} <span class="ml-1" aria-hidden="true">→</span>
            </a>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="mx-auto max-w-5xl px-5 pb-20 sm:px-8">
    <NewsletterCTA
      heading="Stay in the loop"
      body="The Startup Screen Printing newsletter is the steady drip of practical notes for owners who want off the treadmill."
    />
    <p class="sr-only">{NEWSLETTER_URL}</p>
  </section>
</BaseLayout>
