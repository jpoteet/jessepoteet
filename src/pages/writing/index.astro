---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';

const posts = (await getCollection('writing', ({ data }) => data.draft !== true)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<BaseLayout
  title="Writing"
  description="Writing from Jesse Poteet on print shops, systems, and running owner-led businesses."
>
  <div class="mx-auto max-w-3xl px-5 py-14 sm:px-8 sm:py-20">
    <header>
      <p class="text-xs font-semibold uppercase tracking-[0.14em] text-[var(--color-sage)] dark:text-[var(--color-dark-muted)]">
        Writing
      </p>
      <h1 class="mt-3 font-display text-4xl font-semibold sm:text-5xl">Notes from the work</h1>
      <p class="mt-4 text-lg text-[var(--color-ink-muted)] dark:text-[var(--color-dark-muted)]">
        Published posts only. Drafts stay out of this list and out of the RSS feed.
        <a class="font-semibold text-[var(--color-clay)] dark:text-[var(--color-dark-clay)]" href="/rss.xml">Subscribe via RSS</a>.
      </p>
    </header>

    <ul class="mt-12 space-y-8">
      {
        posts.map((post) => (
          <li class="border-t border-[var(--color-line)] pt-6 dark:border-[var(--color-dark-line)]">
            <a href={`/writing/${post.id}/`} class="group block">
              <time
                datetime={post.data.pubDate.toISOString()}
                class="text-xs font-medium uppercase tracking-[0.12em] text-[var(--color-sage)] dark:text-[var(--color-dark-muted)]"
              >
                {post.data.pubDate.toLocaleDateString('en-US', {
                  year: 'numeric',
                  month: 'long',
                  day: 'numeric',
                })}
              </time>
              <h2 class="mt-2 font-display text-2xl font-semibold group-hover:text-[var(--color-clay)] dark:group-hover:text-[var(--color-dark-clay)]">
                {post.data.title}
              </h2>
              <p class="mt-2 text-[var(--color-ink-muted)] dark:text-[var(--color-dark-muted)]">{post.data.description}</p>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</BaseLayout>
