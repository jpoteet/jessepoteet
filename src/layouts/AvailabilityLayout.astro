---
/**
 * Standalone full-viewport layout for /meet.
 * No site header, nav, or footer. App chrome is a dedicated top bar.
 */
import BaseHead from '@/components/BaseHead.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  /** Absolute or site-relative canonical URL (defaults to /meet). */
  canonicalURL?: string;
}

const {
  title,
  description,
  image,
  noindex,
  canonicalURL = '/meet',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={title}
      description={description}
      image={image}
      noindex={noindex}
      canonicalURL={canonicalURL}
      personalOnly
    />
  </head>
  <body class="avail-app">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-[var(--ap-blue-ink)] focus:px-4 focus:py-2 focus:text-white"
    >
      Skip to content
    </a>
    <header class="avail-chrome">
      <a href="/" class="avail-wordmark" aria-label="Jesse Poteet home">
        <span class="avail-wordmark-mark" aria-hidden="true">JP</span>
        <span class="avail-wordmark-name">Jesse Poteet</span>
      </a>
      <div class="avail-chrome-right">
        <div class="avail-hud" data-hud aria-hidden="false">
          <span class="avail-hud-item"
            ><span class="avail-hud-key">MT</span>
            <span data-clock-mt class="avail-mono">--:--:--</span></span
          >
        </div>
      </div>
    </header>
    <main id="main" class="avail-app-main">
      <slot />
    </main>
  </body>
</html>
