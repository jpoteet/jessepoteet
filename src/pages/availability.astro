---
import AvailabilityLayout from '@/layouts/AvailabilityLayout.astro';
import AvailabilityFinder from '@/components/AvailabilityFinder.astro';
import AvailabilityTools from '@/components/AvailabilityTools.astro';
import { personalAvailability } from '@/config/availability';
import '@/styles/availability-product.css';

const profile = personalAvailability;
---

<AvailabilityLayout title={profile.headline} description={profile.description}>
  <div class="avail-stage" data-avail-stage>
    <canvas class="avail-webgl" data-avail-webgl aria-hidden="true"></canvas>
    <div class="avail-aurora" aria-hidden="true">
      <span class="avail-blob avail-blob-a"></span>
      <span class="avail-blob avail-blob-b"></span>
      <span class="avail-blob avail-blob-c"></span>
    </div>

    <div class="avail-app-frame">
      <header class="avail-enter avail-app-header" style="--enter-delay: 0.04s">
        <div class="avail-topbar">
          <div>
            <p class="avail-kicker">{profile.eyebrow}</p>
            <h1 class="avail-brand">{profile.headline}</h1>
          </div>
          <div class="avail-hud" data-hud aria-hidden="false">
            <span class="avail-hud-item"><span class="avail-hud-key">UTC</span> <span data-clock-utc class="avail-mono">--:--:--</span></span>
            <span class="avail-hud-sep" aria-hidden="true"></span>
            <span class="avail-hud-item"><span class="avail-hud-key">MT</span> <span data-clock-mt class="avail-mono">--:--:--</span></span>
          </div>
        </div>
        <p class="avail-lead">{profile.lead}</p>
        <p class="avail-funline" data-funline>Quiet mornings. Clear calendar. Real work. ☀️</p>
      </header>

      <div class="avail-enter" style="--enter-delay: 0.1s">
        <AvailabilityTools />
      </div>

      <div class="avail-enter" style="--enter-delay: 0.16s">
        <AvailabilityFinder
          durations={profile.durations}
          defaultDuration={profile.defaultDuration}
        />
      </div>
    </div>
  </div>
</AvailabilityLayout>

<style is:global>
  @import url('https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap');
</style>

<script is:inline>
  document.documentElement.classList.remove('dark');
</script>

<script is:inline>
  (function () {
    var funLines = [
      'Quiet mornings. Clear calendar. Real work. ☀️',
      'Probably outside when the inbox goes quiet. 🎣',
      'Coffee first. Then the next open slot. ☕',
      'Colorado light, then deep work. 🏔️',
      'Leave a little room for the river. 🌲',
    ];
    function clock(zone) {
      return new Intl.DateTimeFormat('en-GB', {
        timeZone: zone,
        hour: '2-digit',
        minute: '2-digit',
        second: '2-digit',
        hourCycle: 'h23',
      }).format(new Date());
    }
    function tickClocks() {
      var utcEl = document.querySelector('[data-clock-utc]');
      var mtEl = document.querySelector('[data-clock-mt]');
      if (utcEl) utcEl.textContent = clock('UTC') + 'Z';
      if (mtEl) mtEl.textContent = clock('America/Denver');
    }
    tickClocks();
    setInterval(tickClocks, 1000);

    var funEl = document.querySelector('[data-funline]');
    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (funEl && !reduce) {
      var i = 0;
      setInterval(function () {
        i = (i + 1) % funLines.length;
        funEl.style.opacity = '0';
        setTimeout(function () {
          funEl.textContent = funLines[i];
          funEl.style.opacity = '1';
        }, 180);
      }, 5200);
    }
  })();
</script>

<script>
  const canvas = document.querySelector('[data-avail-webgl]') as HTMLCanvasElement | null;
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const lowPower =
    reduce ||
    (typeof navigator.hardwareConcurrency === 'number' && navigator.hardwareConcurrency <= 4) ||
    matchMedia('(max-width: 700px)').matches;

  if (canvas && !lowPower) {
    const boot = () => {
      void import('@/lib/availability/webglTerrain').then(({ createTerrain }) => {
        const handle = createTerrain({ canvas, reducedMotion: reduce });
        if (!handle) canvas.style.display = 'none';
        window.addEventListener('pagehide', () => handle?.destroy(), { once: true });
      });
    };
    if ('requestIdleCallback' in window) {
      (window as Window & { requestIdleCallback: (cb: () => void) => number }).requestIdleCallback(boot);
    } else {
      window.setTimeout(boot, 400);
    }
  } else if (canvas) {
    canvas.style.display = 'none';
  }
</script>
