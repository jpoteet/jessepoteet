---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import NewsletterCTA from '@/components/NewsletterCTA.astro';
import QuoteComparison from '@/components/QuoteComparison.astro';
import IdentityRoles from '@/components/IdentityRoles.astro';
import OffTheClock from '@/components/OffTheClock.astro';
import fishingPhoto from '@/assets/images/jesse-fly-fishing.jpg';
import { SITE } from '@/config/site';
import {
  alpineApparel,
  beliefs,
  operatorStack,
  pressMentions,
  printProStrategies,
} from '@/config/brands';
import { caseStudies, processSteps } from '@/config/expertise';
import { workWithMePaths } from '@/config/contact';

const posts = (await getCollection('writing', ({ data }) => data.draft !== true))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<BaseLayout
  title="Home"
  description="Jesse Poteet helps owner-run businesses, creators, and leaders get off the treadmill. Systems, faith, family, and a little river time. Castle Rock, Colorado."
>
  <section class="bg-[var(--color-hero)] text-[var(--color-hero-ink)]">
    <div class="site-shell grid items-center gap-10 py-14 sm:py-18 lg:grid-cols-[1.15fr_0.85fr] lg:gap-14 lg:py-20">
      <div class="reveal">
        <p class="text-[0.7rem] font-semibold uppercase tracking-[0.18em] text-[var(--color-hero-muted)]">
          {SITE.name} · Castle Rock, Colorado
        </p>
        <div class="mt-5">
          <IdentityRoles onDark />
        </div>
        <h1 class="mt-6 max-w-2xl text-balance font-display text-4xl font-semibold tracking-tight sm:text-5xl lg:text-[3.35rem]">
          I help owner-run businesses get off the treadmill and back to building something that serves their family.
        </h1>
        <p class="mt-6 max-w-xl text-base leading-relaxed text-[var(--color-hero-muted)] sm:text-lg">
          For owners, operators, and creators who are tired of being every bottleneck. Day job in marketing automation for brands like Qualcomm, CVS/Aetna, Honeywell, and Mastercard. Side gigs include Alpine Apparel Co, Operator Stack, and teaching through Startup Screen Printing. Nights and weekends: rivers, recipes, and sawdust.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/speaking" class="btn-on-dark">Book me to speak</a>
          <a href="/contact?type=operator-stack" class="btn-on-dark-ghost">Grab a process review</a>
        </div>
      </div>
      <div class="reveal reveal-delay-1">
        <figure class="overflow-hidden rounded-lg">
          <Image
            src={fishingPhoto}
            alt="Jesse fly fishing in a mountain river"
            widths={[400, 640, 900, 1200]}
            sizes="(max-width: 1024px) 100vw, 38vw"
            class="aspect-[5/4] h-auto w-full object-cover"
            quality={78}
            loading="eager"
            fetchpriority="high"
          />
          <figcaption class="mt-3 text-xs text-[var(--color-hero-muted)]">
            Proof that I leave the building sometimes.
          </figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section class="site-shell section-pad" aria-labelledby="believe-heading">
    <div class="reveal max-w-2xl">
      <p class="eyebrow">What I believe</p>
      <h2 id="believe-heading" class="mt-3 font-display text-3xl font-semibold sm:text-4xl">
        A short filter for how I build and advise
      </h2>
      <p class="mt-3 text-[var(--color-ink-muted)] dark:text-[var(--color-dark-muted)]">
        Serious about the work. Not so serious that we forget why we started.
      </p>
    </div>
    <ul class="mt-12 grid gap-6 sm:grid-cols-2">
      {
        beliefs.map((item, i) => (
          <li class:list={['reveal panel p-6', i === 1 && 'reveal-delay-1', i === 2 && 'reveal-delay-2', i === 3 && 'reveal-delay-3']}>
            <h3 class="font-display text-xl font-semibold">{item.title}</h3>
            <p class="mt-2 text-[var(--color-ink-muted)] dark:text-[var(--color-dark-muted)]">{item.body}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="border-y border-[var(--color-line)] bg-[var(--color-canvas-elevated)] dark:border-[var(--color-dark-line)] dark:bg-[var(--color-dark-elevated)]">
    <div class="site-shell section-pad grid gap-10 lg:grid-cols-[1.1fr_0.9fr] lg:items-start">
      <div class="reveal">
        <p class="eyebrow">Proof</p>
        <h2 class="mt-3 font-display text-3xl font-semibold sm:text-4xl">What changes when the owner is not the bottleneck</h2>
        <div class="mt-8">
          <QuoteComparison />
        </div>
      </div>
      <div class="reveal reveal-delay-1">
        <p class="eyebrow">As featured in</p>
        <ul class="mt-6 flex flex-wrap gap-3">
          {
            pressMentions.map((name) => (
              <li class="border border-[var(--color-line)] bg-[var(--color-canvas)] px-5 py-3 font-display text-lg font-semibold tracking-tight text-[var(--color-ink-muted)] dark:border-[var(--color-dark-line)] dark:bg-[var(--color-dark-canvas)] dark:text-[var(--color-dark-muted)]">
                {name}
              </li>
            ))
          }
        </ul>
        <p class="mt-4 text-sm text-[var(--color-ink-muted)] dark:text-[var(--color-dark-muted)]">
          Plain text on purpose. The work still counts.
        </p>
      </div>
    </div>
  </section>

  <section class="site-shell section-pad" aria-labelledby="process-heading">
    <div class="reveal max-w-2xl">
      <p class="eyebrow">Method</p>
      <h2 id="process-heading" class="mt-3 font-display text-3xl font-semibold sm:text-4xl">
        How I help a business run without you
      </h2>
      <p class="mt-3 text-[var(--color-ink-muted)] dark:text-[var(--color-dark-muted)]">
        Simple on purpose. Whether you run a shop, a crew, a studio, or a growing brand, the pattern is the same.
      </p>
    </div>
    <ol class="mt-12 grid gap-6 md:grid-cols-2 xl:grid-cols-4">
      {
        processSteps.map((step, i) => (
          <li class:list={['reveal panel p-5', i === 1 && 'reveal-delay-1', i === 2 && 'reveal-delay-2', i === 3 && 'reveal-delay-3']}>
            <p class="font-display text-sm font-semibold text-[var(--color-accent)] dark:text-[var(--color-dark-accent)]">{step.step}</p>
            <h3 class="mt-3 font-display text-xl font-semibold">{step.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-[var(--color-ink-muted)] dark:text-[var(--color-dark-muted)]">{step.body}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="border-y border-[var(--color-line)] bg-[var(--color-canvas-elevated)] dark:border-[var(--color-dark-line)] dark:bg-[var(--color-dark-elevated)]" aria-labelledby="cases-heading">
    <div class="site-shell section-pad">
      <div class="reveal max-w-2xl">
        <p class="eyebrow">Selected work</p>
        <h2 id="cases-heading" class="mt-3 font-display text-3xl font-semibold sm:text-4xl">
          Problem, build, result
        </h2>
        <p class="mt-3 text-[var(--color-ink-muted)] dark:text-[var(--color-dark-muted)]">
          Examples across production, systems, software, and education. Print is where the story started, not the only place it applies.
        </p>
      </div>
      <div class="mt-12 grid gap-6 lg:grid-cols-2">
        {
          caseStudies.map((item, i) => (
            <article class:list={['reveal panel p-6', i % 2 === 1 && 'reveal-delay-1']}>
              <p class="eyebrow">{item.eyebrow}</p>
              <h3 class="mt-2 font-display text-2xl font-semibold">{item.name}</h3>
              <dl class="mt-5 space-y-4 text-sm">
                <div>
                  <dt class="font-semibold">Problem</dt>
                  <dd class="mt-1 text-[var(--color-ink-muted)] dark:text-[var(--color-dark-muted)]">{item.problem}</dd>
                </div>
                <div>
                  <dt class="font-semibold">What I built</dt>
                  <dd class="mt-1 text-[var(--color-ink-muted)] dark:text-[var(--color-dark-muted)]">{item.built}</dd>
                </div>
                {'result' in item && item.result && (
                  <div>
                    <dt class="font-semibold">Result</dt>
                    <dd class="mt-1 text-[var(--color-ink-muted)] dark:text-[var(--color-dark-muted)]">{item.result}</dd>
                  </div>
                )}
              </dl>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section id="building" class="site-shell section-pad scroll-mt-24" aria-labelledby="building-heading">
    <div class="reveal max-w-2xl">
      <p class="eyebrow">What I am building</p>
      <h2 id="building-heading" class="mt-3 font-display text-3xl font-semibold sm:text-4xl">
        Brands with a job to do
      </h2>
      <p class="mt-3 text-[var(--color-ink-muted)] dark:text-[var(--color-dark-muted)]">
        Education and software under PrintPro, a production company in Alpine, and Operator Stack for owner-run teams. The side gigs I actually love.
      </p>
    </div>

    <div class="reveal mt-12 panel p-6 sm:p-8">
      <div class="flex flex-wrap items-baseline justify-between gap-3">
        <h3 class="font-display text-2xl font-semibold">{printProStrategies.name}</h3>
        <p class="text-xs font-medium uppercase tracking-[0.12em] text-[var(--color-ink-muted)]">{printProStrategies.legalName}</p>
      </div>
      <p class="mt-3 max-w-3xl text-[var(--color-ink-muted)] dark:text-[var(--color-dark-muted)]">
        <span class="font-semibold text-[var(--color-ink)] dark:text-[var(--color-dark-ink)]">Problem:</span>
        {printProStrategies.problem}
      </p>
      <div class="mt-8 grid gap-8 lg:grid-cols-2">
        <div>
          <p class="eyebrow">Education</p>
          <ul class="mt-4 space-y-3">
            {
              printProStrategies.education.map((child) => (
                <li class="rule pt-3">
                  <p class="font-semibold">
                    {child.url ? (
                      <a href={child.url} rel="noopener noreferrer" target="_blank" class="hover:text-[var(--color-accent)] dark:hover:text-[var(--color-dark-accent)]">
                        {child.name}
                      </a>
                    ) : (
                      child.name
                    )}
                  </p>
                  <p class="mt-1 text-sm text-[var(--color-ink-muted)] dark:text-[var(--color-dark-muted)]">{child.problem}</p>
                </li>
              ))
            }
          </ul>
          <p class="mt-4 text-sm text-[var(--color-ink-muted)] dark:text-[var(--color-dark-muted)]">
            Also under PrintPro Strategies: {printProStrategies.educationAlso.join(', ')}.
          </p>
        </div>
        <div>
          <p class="eyebrow">Software</p>
          <ul class="mt-4 space-y-3">
            {
              printProStrategies.software.map((child) => (
                <li class="rule pt-3">
                  <p class="font-semibold">
                    {child.url ? (
                      <a href={child.url} rel="noopener noreferrer" target="_blank" class="hover:text-[var(--color-accent)] dark:hover:text-[var(--color-dark-accent)]">
                        {child.name}
                      </a>
                    ) : (
                      child.name
                    )}
                  </p>
                  <p class="mt-1 text-sm text-[var(--color-ink-muted)] dark:text-[var(--color-dark-muted)]">{child.blurb}</p>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>

    <div class="mt-6 grid gap-6 sm:grid-cols-2">
      {
        [alpineApparel, operatorStack].map((brand, i) => (
          <article class:list={['reveal panel p-6', i === 1 && 'reveal-delay-1']}>
            <h3 class="font-display text-2xl font-semibold">
              {brand.url ? (
                <a href={brand.url} rel="noopener noreferrer" target="_blank" class="hover:text-[var(--color-accent)] dark:hover:text-[var(--color-dark-accent)]">
                  {brand.name}
                </a>
              ) : (
                brand.name
              )}
            </h3>
            <p class="mt-3 text-sm text-[var(--color-ink-muted)] dark:text-[var(--color-dark-muted)]">
              <span class="font-semibold text-[var(--color-ink)] dark:text-[var(--color-dark-ink)]">Problem:</span> {brand.problem}
            </p>
          </article>
        ))
      }
    </div>
    <p class="mt-8">
      <a href="/work" class="text-sm font-semibold text-[var(--color-accent)] dark:text-[var(--color-dark-accent)]">Full ventures map →</a>
    </p>
  </section>

  <OffTheClock />

  <section class="border-t border-[var(--color-line)] dark:border-[var(--color-dark-line)]" aria-labelledby="ideas-heading">
    <div class="site-shell section-pad">
      <div class="reveal flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="eyebrow">Ideas</p>
          <h2 id="ideas-heading" class="mt-3 font-display text-3xl font-semibold">Latest writing</h2>
        </div>
        <a href="/writing" class="text-sm font-semibold text-[var(--color-accent)] dark:text-[var(--color-dark-accent)]">All writing →</a>
      </div>
      <ul class="mt-10 space-y-0">
        {
          posts.map((post) => (
            <li class="reveal rule py-6">
              <a href={`/writing/${post.id}/`} class="group block">
                <time
                  datetime={post.data.pubDate.toISOString()}
                  class="text-xs font-medium uppercase tracking-[0.12em] text-[var(--color-ink-muted)] dark:text-[var(--color-dark-muted)]"
                >
                  {post.data.pubDate.toLocaleDateString('en-US', {
                    year: 'numeric',
                    month: 'long',
                    day: 'numeric',
                  })}
                </time>
                <h3 class="mt-2 font-display text-2xl font-semibold group-hover:text-[var(--color-accent)] dark:group-hover:text-[var(--color-dark-accent)]">
                  {post.data.title}
                </h3>
                <p class="mt-1 text-[var(--color-ink-muted)] dark:text-[var(--color-dark-muted)]">{post.data.description}</p>
              </a>
            </li>
          ))
        }
      </ul>
      <p class="mt-4 text-sm text-[var(--color-ink-muted)] dark:text-[var(--color-dark-muted)]">
        Videos live on
        <a class="font-semibold text-[var(--color-accent)] dark:text-[var(--color-dark-accent)]" href="https://jpoteet.us/ssp" rel="noopener noreferrer">
          Startup Screen Printing
        </a>.
      </p>
    </div>
  </section>

  <section id="work-with-me" class="scroll-mt-24 border-t border-[var(--color-line)] bg-[var(--color-canvas-elevated)] dark:border-[var(--color-dark-line)] dark:bg-[var(--color-dark-elevated)]" aria-labelledby="wwm-heading">
    <div class="site-shell section-pad">
      <div class="reveal max-w-2xl">
        <p class="eyebrow">Work with me</p>
        <h2 id="wwm-heading" class="mt-3 font-display text-3xl font-semibold sm:text-4xl">Three clear doors</h2>
        <p class="mt-3 text-[var(--color-ink-muted)] dark:text-[var(--color-dark-muted)]">
          Pick one. Or send a note that says "I am not sure which door" and we will figure it out.
        </p>
      </div>
      <ol class="mt-12 grid gap-6 md:grid-cols-3">
        {
          workWithMePaths.map((path, index) => (
            <li class:list={['reveal panel p-6', index === 1 && 'reveal-delay-1', index === 2 && 'reveal-delay-2']}>
              <p class="eyebrow">{String(index + 1).padStart(2, '0')}</p>
              <h3 class="mt-3 font-display text-xl font-semibold">{path.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-[var(--color-ink-muted)] dark:text-[var(--color-dark-muted)]">
                {path.description}
              </p>
              <a
                href={path.href}
                class="mt-5 inline-flex text-sm font-semibold text-[var(--color-accent)] dark:text-[var(--color-dark-accent)]"
                rel={'external' in path && path.external ? 'noopener noreferrer' : undefined}
              >
                {path.cta} <span class="ml-1" aria-hidden="true">→</span>
              </a>
            </li>
          ))
        }
      </ol>
      <div class="reveal mt-12">
        <NewsletterCTA
          heading="Stay in the loop"
          body="Practical notes for owners who want off the treadmill. A little personality included. Published through Startup Screen Printing."
        />
      </div>
    </div>
  </section>
</BaseLayout>
