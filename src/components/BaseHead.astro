---
import { SITE } from '@/config/site';
import { getResolvedSameAs } from '@/config/social';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonicalURL?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  /** When true, JSON-LD sameAs lists only personal social profiles (no brand URLs). */
  personalOnly?: boolean;
  /**
   * When true, skip the site-wide Fraunces / Source Sans link.
   * Used by /meet, which loads its own display + body fonts.
   */
  skipDefaultFonts?: boolean;
}

const {
  title,
  description = SITE.description,
  image = SITE.ogImage,
  canonicalURL = Astro.url.href,
  type = 'website',
  noindex = false,
  personalOnly = false,
  skipDefaultFonts = false,
} = Astro.props;

const pageTitle = title ? `${title} · ${SITE.name}` : `${SITE.name} · ${SITE.tagline}`;
const absoluteImage = new URL(image, Astro.site).href;
const canonical = new URL(canonicalURL, Astro.site).href;
const sameAs = getResolvedSameAs({ personalOnly });

const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: SITE.name,
  url: SITE.url,
  jobTitle: 'Business coach, content creator, and systems builder',
  description: SITE.tagline,
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Castle Rock',
    addressRegion: 'CO',
    addressCountry: 'US',
  },
  sameAs,
};
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="canonical" href={canonical} />
<title>{pageTitle}</title>
<meta name="description" content={description} />
{noindex && <meta name="robots" content="noindex,nofollow" />}
<meta name="author" content={SITE.author} />

<meta property="og:type" content={type} />
<meta property="og:url" content={canonical} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={absoluteImage} />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:locale" content={SITE.locale} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={absoluteImage} />

<link rel="alternate" type="application/rss+xml" title={`${SITE.name} writing`} href="/rss.xml" />

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
{
  !skipDefaultFonts && (
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=Source+Sans+3:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap"
      rel="stylesheet"
    />
  )
}

<script is:inline>
  (function () {
    try {
      const stored = localStorage.getItem('theme');
      const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      if (stored === 'dark' || (!stored && prefersDark)) {
        document.documentElement.classList.add('dark');
      }
    } catch (_) {}
  })();
</script>

<script type="application/ld+json" set:html={JSON.stringify(personJsonLd)} />
