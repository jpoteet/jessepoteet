---
import AvailabilityLayout from '@/layouts/AvailabilityLayout.astro';
import AvailabilityFinder from '@/components/AvailabilityFinder.astro';
import { personalAvailability } from '@/config/availability';
import '@/styles/availability-product.css';

const profile = personalAvailability;
---

<AvailabilityLayout title={profile.headline} description={profile.description}>
  <div class="avail-stage" data-avail-stage>
    <canvas class="avail-webgl" data-avail-webgl aria-hidden="true"></canvas>
    <div class="avail-aurora" aria-hidden="true">
      <span class="avail-blob avail-blob-a"></span>
      <span class="avail-blob avail-blob-b"></span>
      <span class="avail-blob avail-blob-c"></span>
    </div>
    <div class="avail-floats" aria-hidden="true">
      <span class="avail-float" style="left: 0.6%; top: 14%; animation-delay: 0s">🎣</span>
      <span class="avail-float" style="left: 97%; top: 22%; animation-delay: 1.1s">☕</span>
      <span class="avail-float" style="left: 0.4%; top: 62%; animation-delay: 2.2s">🏔️</span>
      <span class="avail-float" style="left: 96.5%; top: 74%; animation-delay: 0.7s">🌲</span>
      <span class="avail-float avail-float-sm" style="left: 48%; top: 4%; animation-delay: 1.6s">🚲</span>
    </div>

    <div class="avail-app-shell">
      <AvailabilityFinder
        durations={profile.durations}
        defaultDuration={profile.defaultDuration}
        headline={profile.headline}
        lead={profile.lead}
      />
    </div>
  </div>
</AvailabilityLayout>

<style is:global>
  @import url('https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap');
</style>

<script is:inline>
  document.documentElement.classList.remove('dark');
</script>

<script is:inline>
  (function () {
    function clock(zone) {
      return new Intl.DateTimeFormat('en-US', {
        timeZone: zone,
        hour: 'numeric',
        minute: '2-digit',
      }).format(new Date());
    }
    function tickClocks() {
      var mtEl = document.querySelector('[data-clock-mt]');
      if (mtEl) mtEl.textContent = clock('America/Denver');
    }
    tickClocks();
    setInterval(tickClocks, 30000);
  })();
</script>

<script>
  const canvas = document.querySelector('[data-avail-webgl]') as HTMLCanvasElement | null;
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const lowPower =
    reduce ||
    (typeof navigator.hardwareConcurrency === 'number' && navigator.hardwareConcurrency <= 4) ||
    matchMedia('(max-width: 700px)').matches;

  if (canvas && !lowPower) {
    const boot = () => {
      void import('@/lib/availability/webglTerrain').then(({ createTerrain }) => {
        const handle = createTerrain({ canvas, reducedMotion: reduce });
        if (!handle) canvas.style.display = 'none';
        window.addEventListener('pagehide', () => handle?.destroy(), { once: true });
      });
    };
    if ('requestIdleCallback' in window) {
      (window as Window & { requestIdleCallback: (cb: () => void) => number }).requestIdleCallback(boot);
    } else {
      window.setTimeout(boot, 400);
    }
  } else if (canvas) {
    canvas.style.display = 'none';
  }
</script>
