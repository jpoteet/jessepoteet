# Cloudflare Pages / local Wrangler secrets
# Copy to .dev.vars for `wrangler pages dev` (never commit .dev.vars)

# Required in production & preview for live availability
RECLAIM_API_TOKEN=

# Dev only. When true and RECLAIM_API_TOKEN is empty, /api/availability
# serves mock busy intervals. Do NOT set this on the production environment.
ALLOW_MOCK_AVAILABILITY=

# Existing contact form webhook
CONTACT_WEBHOOK_URL=
CONTACT_WEBHOOK_SECRET=
