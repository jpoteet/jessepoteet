---
/**
 * Standalone layout for /meet.
 * No site header, nav, or footer chrome. The page scrolls normally.
 */
import BaseHead from '@/components/BaseHead.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  /** Absolute or site-relative canonical URL (defaults to /meet). */
  canonicalURL?: string;
}

const {
  title,
  description,
  image,
  noindex,
  canonicalURL = '/meet',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={title}
      description={description}
      image={image}
      noindex={noindex}
      canonicalURL={canonicalURL}
      personalOnly
      skipDefaultFonts
    />
  </head>
  <body class="avail-app">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-[var(--ap-blue-ink)] focus:px-4 focus:py-2 focus:text-white"
    >
      Skip to content
    </a>
    <main id="main" class="avail-app-main">
      <slot />
    </main>
  </body>
</html>
