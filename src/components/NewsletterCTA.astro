---
import { NEWSLETTER_URL } from '@/config/site';

interface Props {
  heading?: string;
  body?: string;
}

const {
  heading = 'Practical notes for print shop owners',
  body = 'The Startup Screen Printing newsletter covers getting off the press, pricing, and running a shop that does not require you at every station.',
} = Astro.props;
---

<aside class="relative overflow-hidden rounded-lg bg-[var(--color-pine)] px-6 py-10 text-[var(--color-canvas)] sm:px-10 dark:bg-[var(--color-pine-deep)]">
  <div
    class="pointer-events-none absolute -right-10 -top-16 h-48 w-48 rounded-full bg-[var(--color-clay)]/20 blur-2xl"
    aria-hidden="true"
  >
  </div>
  <div class="relative max-w-xl">
    <h2 class="font-display text-2xl font-semibold sm:text-3xl">{heading}</h2>
    <p class="mt-3 text-base leading-relaxed text-white/80">{body}</p>
    <a
      href={NEWSLETTER_URL}
      class="mt-6 inline-flex items-center gap-2 rounded-md bg-[var(--color-clay)] px-5 py-3 text-sm font-semibold text-white transition hover:bg-[var(--color-clay-hover)]"
      rel="noopener noreferrer"
    >
      Subscribe at news.startupscreenprinting.com
      <span aria-hidden="true">→</span>
    </a>
  </div>
</aside>
