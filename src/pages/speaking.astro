---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PhotoSlot from '@/components/PhotoSlot.astro';
import { speakerBios, talkTopics } from '@/config/contact';
---

<BaseLayout
  title="Speaking"
  description="Speaker kit for Jesse Poteet: bios, headshot, talk topics, and booking form."
>
  <article class="mx-auto max-w-3xl px-5 py-14 sm:px-8 sm:py-20">
    <p class="text-xs font-semibold uppercase tracking-[0.14em] text-[var(--color-sage)] dark:text-[var(--color-dark-muted)]">
      Speaking
    </p>
    <h1 class="mt-3 font-display text-4xl font-semibold sm:text-5xl">Speaker kit</h1>
    <p class="mt-4 text-lg text-[var(--color-ink-muted)] dark:text-[var(--color-dark-muted)]">
      For podcast hosts, conference organizers, and teams who want a practical voice on print shops, systems, and owner-run business.
    </p>

    <div class="mt-8 flex flex-wrap gap-3">
      <a
        href="/contact?type=podcast"
        class="inline-flex rounded-md bg-[var(--color-pine)] px-5 py-3 text-sm font-semibold text-white dark:bg-[var(--color-dark-pine)] dark:text-[var(--color-dark-canvas)]"
      >
        Book a podcast guest
      </a>
      <a
        href="/contact?type=speaking"
        class="inline-flex rounded-md border border-[var(--color-line)] px-5 py-3 text-sm font-semibold dark:border-[var(--color-dark-line)]"
      >
        Book a speaking engagement
      </a>
    </div>

    <section class="mt-14 border-t border-[var(--color-line)] pt-10 dark:border-[var(--color-dark-line)]">
      <h2 class="font-display text-2xl font-semibold">Headshot</h2>
      <div class="mt-5 max-w-sm">
        <PhotoSlot
          label="Jesse Poteet headshot"
          src="/images/photos/jesse-hero.jpg"
          aspect="square"
        />
      </div>
      <p class="mt-3 text-sm text-[var(--color-ink-muted)] dark:text-[var(--color-dark-muted)]">
        [JESSE: high-res speaker headshot path if different from site photo]
      </p>
    </section>

    <section class="mt-12 border-t border-[var(--color-line)] pt-10 dark:border-[var(--color-dark-line)]">
      <h2 class="font-display text-2xl font-semibold">Short bio</h2>
      <p class="mt-4 leading-relaxed text-[var(--color-ink-muted)] dark:text-[var(--color-dark-muted)]">
        {speakerBios.short}
      </p>
    </section>

    <section class="mt-12 border-t border-[var(--color-line)] pt-10 dark:border-[var(--color-dark-line)]">
      <h2 class="font-display text-2xl font-semibold">Long bio</h2>
      <div class="mt-4 space-y-4 leading-relaxed text-[var(--color-ink-muted)] dark:text-[var(--color-dark-muted)] whitespace-pre-line">
        {speakerBios.long}
      </div>
    </section>

    <section class="mt-12 border-t border-[var(--color-line)] pt-10 dark:border-[var(--color-dark-line)]">
      <h2 class="font-display text-2xl font-semibold">Talk topics</h2>
      <ul class="mt-6 space-y-6">
        {
          talkTopics.map((topic) => (
            <li class="border-t border-[var(--color-line)]/80 pt-5 dark:border-[var(--color-dark-line)]">
              <h3 class="font-display text-xl font-semibold">{topic.title}</h3>
              <p class="mt-2 text-[var(--color-ink-muted)] dark:text-[var(--color-dark-muted)]">{topic.body}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="mt-12 rounded-lg bg-[var(--color-pine)] px-6 py-8 text-[var(--color-canvas)] dark:bg-[var(--color-pine-deep)]">
      <h2 class="font-display text-2xl font-semibold">Ready to book?</h2>
      <p class="mt-2 text-white/80">
        Use the contact form with the right request type so the note lands in the right pile.
      </p>
      <div class="mt-5 flex flex-wrap gap-3">
        <a href="/contact?type=podcast" class="rounded-md bg-[var(--color-clay)] px-4 py-2.5 text-sm font-semibold text-white hover:bg-[var(--color-clay-hover)]">
          Podcast guest form
        </a>
        <a href="/contact?type=speaking" class="rounded-md border border-white/30 px-4 py-2.5 text-sm font-semibold text-white">
          Speaking form
        </a>
        <a href="/contact?type=press" class="rounded-md border border-white/30 px-4 py-2.5 text-sm font-semibold text-white">
          Press / media
        </a>
      </div>
    </section>
  </article>
</BaseLayout>
