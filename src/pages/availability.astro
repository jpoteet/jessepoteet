---
import BaseLayout from '@/layouts/BaseLayout.astro';
import AvailabilityFinder from '@/components/AvailabilityFinder.astro';
import AvailabilityTools from '@/components/AvailabilityTools.astro';
import { personalAvailability } from '@/config/availability';
import '@/styles/availability-product.css';

const profile = personalAvailability;
---

<BaseLayout
  title={profile.headline}
  description={profile.description}
  personalOnly
  bodyClass="avail-product dark"
>
  <div class="avail-stage" data-avail-stage>
    <canvas class="avail-webgl" data-avail-webgl aria-hidden="true"></canvas>
    <div class="avail-aurora" aria-hidden="true">
      <span class="avail-blob avail-blob-a"></span>
      <span class="avail-blob avail-blob-b"></span>
      <span class="avail-blob avail-blob-c"></span>
    </div>
    <div class="avail-grid-motion" aria-hidden="true"></div>
    <div class="avail-noise" aria-hidden="true"></div>

    <article class="avail-shell">
      <header class="avail-enter" style="--enter-delay: 0.04s">
        <div class="avail-topbar">
          <p class="avail-kicker">{profile.eyebrow}</p>
          <div class="avail-hud" data-hud aria-hidden="false">
            <span class="avail-hud-item"><span class="avail-hud-key">UTC</span> <span data-clock-utc class="avail-mono">--:--:--</span></span>
            <span class="avail-hud-sep" aria-hidden="true"></span>
            <span class="avail-hud-item"><span class="avail-hud-key">MT</span> <span data-clock-mt class="avail-mono">--:--:--</span></span>
          </div>
        </div>
        <h1 class="avail-brand">{profile.displayName}</h1>
        <p class="avail-lead">{profile.lead}</p>
        <p class="avail-funline" data-funline>Quiet mornings. Clear calendar. Real work.</p>
      </header>

      <div class="avail-enter" style="--enter-delay: 0.12s">
        <AvailabilityTools />
      </div>

      <div class="avail-enter" style="--enter-delay: 0.2s">
        <AvailabilityFinder
          bookingUrl={profile.bookingUrl}
          bookingCta={profile.bookingCta}
          durations={profile.durations}
          defaultDuration={profile.defaultDuration}
        />
      </div>
    </article>
  </div>
</BaseLayout>

<style is:global>
  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap');
</style>

<script is:inline>
  document.documentElement.classList.add('dark');
</script>

<script>
  const funLines = [
    'Quiet mornings. Clear calendar. Real work.',
    'Probably outside when the inbox goes quiet.',
    'Coffee first. Then the next open slot.',
    'Colorado light, then deep work.',
  ];

  const utcEl = document.querySelector('[data-clock-utc]');
  const mtEl = document.querySelector('[data-clock-mt]');
  const funEl = document.querySelector('[data-funline]');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function tickClocks() {
    const now = new Date();
    if (utcEl) utcEl.textContent = formatTimeInZone(now, 'UTC').replace(' ', '') + 'Z';
    // Use 24h mono style for HUD feel
    const fmt = new Intl.DateTimeFormat('en-GB', {
      timeZone: 'America/Denver',
      hour: '2-digit',
      minute: '2-digit',
      second: '2-digit',
      hourCycle: 'h23',
    });
    if (mtEl) mtEl.textContent = fmt.format(now);
    const utcFmt = new Intl.DateTimeFormat('en-GB', {
      timeZone: 'UTC',
      hour: '2-digit',
      minute: '2-digit',
      second: '2-digit',
      hourCycle: 'h23',
    });
    if (utcEl) utcEl.textContent = `${utcFmt.format(now)}Z`;
  }
  tickClocks();
  window.setInterval(tickClocks, 1000);

  if (funEl && !reduce) {
    let i = 0;
    window.setInterval(() => {
      i = (i + 1) % funLines.length;
      funEl.animate(
        [
          { opacity: 1, transform: 'translateY(0)' },
          { opacity: 0, transform: 'translateY(4px)' },
        ],
        { duration: 180, fill: 'forwards', easing: 'cubic-bezier(0.22, 1, 0.36, 1)' },
      ).finished.then(() => {
        funEl.textContent = funLines[i];
        funEl.animate(
          [
            { opacity: 0, transform: 'translateY(4px)' },
            { opacity: 1, transform: 'translateY(0)' },
          ],
          { duration: 280, fill: 'forwards', easing: 'cubic-bezier(0.22, 1, 0.36, 1)' },
        );
      });
    }, 5200);
  }

  // Lazy WebGL terrain
  const canvas = document.querySelector('[data-avail-webgl]') as HTMLCanvasElement | null;
  const lowPower =
    reduce ||
    (navigator.hardwareConcurrency && navigator.hardwareConcurrency <= 4) ||
    matchMedia('(max-width: 700px)').matches;

  if (canvas && !lowPower) {
    const boot = () => {
      void import('@/lib/availability/webglTerrain').then(({ createTerrain }) => {
        const handle = createTerrain({ canvas, reducedMotion: reduce });
        if (!handle) canvas.style.display = 'none';
        window.addEventListener(
          'pagehide',
          () => {
            handle?.destroy();
          },
          { once: true },
        );
      });
    };
    if ('requestIdleCallback' in window) {
      (window as Window & { requestIdleCallback: (cb: () => void) => void }).requestIdleCallback(boot);
    } else {
      window.setTimeout(boot, 400);
    }
  } else if (canvas) {
    canvas.style.display = 'none';
  }
</script>
