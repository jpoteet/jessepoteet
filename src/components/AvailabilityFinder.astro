---
import { personalAvailability } from '@/config/availability';

interface Props {
  bookingUrl?: string;
  bookingCta?: string;
  durations?: readonly number[];
  defaultDuration?: number;
}

const {
  bookingUrl = personalAvailability.bookingUrl,
  bookingCta = personalAvailability.bookingCta,
  durations = personalAvailability.durations,
  defaultDuration = personalAvailability.defaultDuration,
} = Astro.props;

const defaultIndex = Math.max(0, durations.indexOf(defaultDuration));
---

<div
  id="availability-finder"
  class="availability-finder avail-panel"
  data-booking-url={bookingUrl}
  data-default-duration={String(defaultDuration)}
  data-durations={JSON.stringify(durations)}
>
  <div class="avail-panel-inner">
    <div class="avail-status-row" aria-live="polite">
      <div class="avail-live" data-live data-state="loading">
        <span class="avail-live-dot" aria-hidden="true"></span>
        <span data-live-label>Connecting to calendar…</span>
      </div>
      <div class="avail-chip" data-sync hidden>synced just now</div>
      <div class="avail-chip" data-zone-chip>Detecting time zone…</div>
    </div>

    <div class="avail-hero-stat" data-hero>
      <p class="avail-hero-label">Next opening</p>
      <p class="avail-hero-value" data-next-opening aria-live="polite">Loading…</p>
      <p class="avail-hero-meta" data-next-meta></p>
    </div>

    <div class="avail-divider" aria-hidden="true"></div>

    <section aria-labelledby="length-heading">
      <h2 id="length-heading" class="avail-section-label">1. How long do you need?</h2>
      <div
        class="avail-segment"
        role="group"
        aria-label="Meeting length"
        data-duration-segment
        style={`--seg-count: ${durations.length}; --seg-index: ${defaultIndex};`}
      >
        <div class="avail-segment-thumb" data-duration-thumb aria-hidden="true"></div>
        {
          durations.map((mins, i) => (
            <button
              type="button"
              class="duration-btn"
              data-duration={mins}
              data-index={i}
              aria-pressed={mins === defaultDuration ? 'true' : 'false'}
            >
              {mins} min
            </button>
          ))
        }
      </div>
      <p class="avail-hint">
        Tip: press <span class="avail-kbd">1</span>
        <span class="avail-kbd">2</span>
        <span class="avail-kbd">3</span>
        <span class="avail-kbd">4</span>
        to switch length
      </p>
    </section>

    <div class="avail-divider" aria-hidden="true"></div>

    <section aria-labelledby="window-heading">
      <h2 id="window-heading" class="avail-section-label">2. When should we look?</h2>
      <div class="avail-pills" role="group" aria-label="Date window">
        <button type="button" class="avail-pill window-btn" data-window="this-week" aria-pressed="true">
          This week
        </button>
        <button type="button" class="avail-pill window-btn" data-window="next-week" aria-pressed="false">
          Next week
        </button>
        <button type="button" class="avail-pill window-btn" data-window="custom" aria-pressed="false">
          Custom range
        </button>
      </div>

      <div id="custom-range" class="avail-date-grid hidden" data-custom-range hidden>
        <label class="avail-date-field">
          <span>From</span>
          <input type="date" id="range-start" />
        </label>
        <label class="avail-date-field">
          <span>Through</span>
          <input type="date" id="range-end" />
        </label>
      </div>

      <div class="avail-pills" style="margin-top: 0.85rem;" role="group" aria-label="Morning or afternoon">
        <button type="button" class="avail-pill tod-btn" data-tod="all" aria-pressed="true">All times</button>
        <button type="button" class="avail-pill tod-btn" data-tod="morning" aria-pressed="false">Morning</button>
        <button type="button" class="avail-pill tod-btn" data-tod="afternoon" aria-pressed="false">Afternoon</button>
      </div>
    </section>

    <div class="avail-divider" aria-hidden="true"></div>

    <p class="avail-status" data-status>Checking the calendar…</p>

    <div class="avail-skeleton" data-skeleton hidden>
      <div class="avail-skel-line lg"></div>
      <div class="avail-skel-line" style="width: 72%;"></div>
      <div class="avail-skel-line" style="width: 54%;"></div>
      <div class="avail-skel-line lg" style="margin-top: 0.5rem;"></div>
      <div class="avail-skel-line" style="width: 66%;"></div>
    </div>

    <div id="slot-results" class="mt-4" data-results></div>

    <a href={bookingUrl} class="avail-cta" rel="noopener noreferrer" data-book-btn>
      {bookingCta}
      <span aria-hidden="true">↗</span>
    </a>
    <p class="avail-cta-note">
      Booking happens on Jesse’s scheduling page. Nothing is reserved here.
    </p>
  </div>
</div>

<script>
  import { buildMockAvailabilityResponse } from '@/lib/availability/mock';
  import {
    dayHeatStrip,
    filterByTimeOfDay,
    generateSlots,
    groupSlotsByDay,
    nextDateWithRoom,
    nextOpening,
  } from '@/lib/availability/slots';
  import {
    addDaysInZone,
    dateKeyInZone,
    detectVisitorTimeZone,
    formatShortDate,
    formatTimeInZone,
    friendlyZoneName,
    parseInstant,
    startOfDayInZone,
    startOfWeekMondayInZone,
  } from '@/lib/availability/time';
  import type {
    AvailabilityResponse,
    AvailabilitySuccess,
    TimeOfDayFilter,
    WindowPreset,
  } from '@/lib/availability/types';

  function escapeHtml(value: string) {
    return value
      .replaceAll('&', '&amp;')
      .replaceAll('<', '&lt;')
      .replaceAll('>', '&gt;')
      .replaceAll('"', '&quot;');
  }

  function isLocalHost() {
    const host = window.location.hostname;
    return host === 'localhost' || host === '127.0.0.1';
  }

  function prefersReducedMotion() {
    return window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  }

  const root = document.getElementById('availability-finder');
  if (root) {
    const durations = JSON.parse(root.dataset.durations || '[15,30,60,90]') as number[];
    const defaultDuration = Number(root.dataset.defaultDuration || 30);
    let duration = defaultDuration;
    let windowPreset: WindowPreset = 'this-week';
    let timeOfDay: TimeOfDayFilter = 'all';
    let data: AvailabilitySuccess | null = null;
    let loadError: string | null = null;
    let fetchedAt: number | null = null;
    let selectedSlotStart: string | null = null;
    let heroAnimToken = 0;
    const visitorZone = detectVisitorTimeZone();

    const statusEl = root.querySelector('[data-status]') as HTMLElement;
    const resultsEl = root.querySelector('[data-results]') as HTMLElement;
    const nextEl = root.querySelector('[data-next-opening]') as HTMLElement;
    const nextMetaEl = root.querySelector('[data-next-meta]') as HTMLElement;
    const liveEl = root.querySelector('[data-live]') as HTMLElement;
    const liveLabelEl = root.querySelector('[data-live-label]') as HTMLElement;
    const syncEl = root.querySelector('[data-sync]') as HTMLElement;
    const zoneChipEl = root.querySelector('[data-zone-chip]') as HTMLElement;
    const skeletonEl = root.querySelector('[data-skeleton]') as HTMLElement;
    const customWrap = root.querySelector('[data-custom-range]') as HTMLElement;
    const durationSegment = root.querySelector('[data-duration-segment]') as HTMLElement;
    const rangeStartInput = root.querySelector('#range-start') as HTMLInputElement;
    const rangeEndInput = root.querySelector('#range-end') as HTMLInputElement;

    zoneChipEl.textContent = friendlyZoneName(visitorZone);
    zoneChipEl.title = `Times shown in ${friendlyZoneName(visitorZone)}. Jesse’s open hours are Mountain Time.`;

    const todayKey = dateKeyInZone(new Date(), visitorZone);
    rangeStartInput.min = todayKey;
    rangeEndInput.min = todayKey;
    rangeStartInput.value = todayKey;
    rangeEndInput.value = dateKeyInZone(
      addDaysInZone(startOfDayInZone(new Date(), visitorZone), 6, visitorZone),
      visitorZone,
    );

    function setPressed(selector: string, attr: string, value: string) {
      root!.querySelectorAll(selector).forEach((btn) => {
        const el = btn as HTMLElement;
        el.setAttribute(
          'aria-pressed',
          el.getAttribute(attr) === value ? 'true' : 'false',
        );
      });
    }

    function flashPanel() {
      if (prefersReducedMotion()) return;
      root!.dataset.flash = 'false';
      void root!.offsetWidth;
      root!.dataset.flash = 'true';
      window.setTimeout(() => {
        root!.dataset.flash = 'false';
      }, 480);
    }

    function setDuration(next: number) {
      if (!durations.includes(next)) return;
      duration = next;
      const index = durations.indexOf(next);
      durationSegment.style.setProperty('--seg-index', String(index));
      setPressed('.duration-btn', 'data-duration', String(duration));
      selectedSlotStart = null;
      flashPanel();
      render({ animateHero: true });
    }

    function windowExclusiveEnd(now = new Date()): Date {
      if (windowPreset === 'custom' && rangeEndInput.value) {
        const endStart = startOfDayInZone(
          parseInstant(`${rangeEndInput.value}T17:00:00.000Z`),
          visitorZone,
        );
        return addDaysInZone(endStart, 1, visitorZone);
      }
      const monday = startOfWeekMondayInZone(now, visitorZone);
      if (windowPreset === 'this-week') return addDaysInZone(monday, 7, visitorZone);
      return addDaysInZone(monday, 14, visitorZone);
    }

    function updateSyncLabel() {
      if (!fetchedAt) {
        syncEl.hidden = true;
        return;
      }
      const mins = Math.max(0, Math.floor((Date.now() - fetchedAt) / 60000));
      syncEl.hidden = false;
      syncEl.textContent =
        mins === 0 ? 'synced just now' : `synced ${mins} min ago`;
    }

    function setLive(state: 'loading' | 'live' | 'error', label: string) {
      liveEl.dataset.state = state;
      liveLabelEl.textContent = label;
    }

    function showSkeleton(show: boolean) {
      skeletonEl.hidden = !show;
      if (show) resultsEl.innerHTML = '';
    }

    function renderError() {
      nextEl.textContent = 'Unavailable right now';
      nextMetaEl.textContent = '';
      resultsEl.innerHTML = '';
      showSkeleton(false);
      setLive(
        'error',
        'Availability is unavailable right now',
      );
      statusEl.innerHTML = `<div class="avail-empty"><strong>Availability is unavailable right now</strong>${escapeHtml(
        loadError ||
          'You can still book a time on Jesse’s scheduling page.',
      )}</div>`;
    }

    function renderHero(openingText: string, metaText: string, animate: boolean) {
      const token = ++heroAnimToken;
      if (animate && !prefersReducedMotion()) {
        nextEl.dataset.animate = 'false';
        // restart CSS animation
        void nextEl.offsetWidth;
        nextEl.dataset.animate = 'true';
      } else {
        nextEl.dataset.animate = 'false';
      }
      nextEl.textContent = openingText;
      nextMetaEl.textContent = metaText;
      // clear animate flag after run so it can retrigger
      window.setTimeout(() => {
        if (token === heroAnimToken) nextEl.dataset.animate = 'false';
      }, 500);
    }

    function heatHtml(dayDate: Date) {
      if (!data) return '';
      const cells = dayHeatStrip(dayDate, data.busy, data.meta);
      return `<div class="avail-heat" aria-hidden="true">${cells
        .map((c) => `<span data-open="${c.open ? 'true' : 'false'}"></span>`)
        .join('')}</div>`;
    }

    function render(opts: { animateHero?: boolean } = {}) {
      if (!data) {
        renderError();
        return;
      }

      showSkeleton(false);
      setLive('live', "Live from Jesse’s calendar");
      updateSyncLabel();

      const opening = nextOpening(data.busy, data.meta, duration);
      if (opening) {
        const start = parseInstant(opening.start);
        renderHero(
          `${formatShortDate(start, visitorZone)} · ${formatTimeInZone(start, visitorZone)}`,
          `${duration} minutes · your time zone`,
          !!opts.animateHero,
        );
      } else {
        renderHero(
          `No openings for ${duration} minutes`,
          'in the next few weeks',
          !!opts.animateHero,
        );
      }

      const query =
        windowPreset === 'custom'
          ? {
              durationMinutes: duration,
              visitorTimeZone: visitorZone,
              rangeStartKey: rangeStartInput.value,
              rangeEndKey: rangeEndInput.value,
            }
          : {
              durationMinutes: duration,
              visitorTimeZone: visitorZone,
              preset: windowPreset,
            };

      let slots = generateSlots(data.busy, data.meta, query);
      slots = filterByTimeOfDay(slots, visitorZone, timeOfDay);
      const groups = groupSlotsByDay(slots, visitorZone);

      if (!groups.length) {
        const hint = nextDateWithRoom(
          data.busy,
          data.meta,
          duration,
          visitorZone,
          windowExclusiveEnd(),
        );
        let detail = 'Nothing open in that window.';
        if (hint) detail += ` The next day with room is ${hint.label}.`;
        else detail += ' There is not another opening in the loaded range either.';

        statusEl.innerHTML = `<div class="avail-empty"><strong>Quiet calendar for that filter</strong>${escapeHtml(detail)}</div>`;
        resultsEl.innerHTML = '';
        return;
      }

      statusEl.textContent = `${slots.length} open start${slots.length === 1 ? '' : 's'} in this window.`;

      resultsEl.innerHTML = groups
        .map((group, index) => {
          const dayDate = parseInstant(group.slots[0].start);
          return `
          <section class="avail-day" style="animation-delay: ${Math.min(index, 8) * 0.05}s" aria-labelledby="day-${group.dateKey}">
            <div class="avail-day-head">
              <h3 id="day-${group.dateKey}" class="avail-day-title">${escapeHtml(group.label)}</h3>
              <p class="avail-day-count">${group.slots.length} open</p>
            </div>
            ${heatHtml(dayDate)}
            <ul class="avail-slots">
              ${group.slots
                .map((slot, slotIndex) => {
                  const label = formatTimeInZone(parseInstant(slot.start), visitorZone);
                  const pressed = selectedSlotStart === slot.start ? 'true' : 'false';
                  return `<li style="display:contents"><button type="button" class="avail-slot" data-slot-start="${escapeHtml(slot.start)}" aria-pressed="${pressed}" style="animation-delay: ${Math.min(slotIndex, 12) * 0.03}s">${escapeHtml(label)}</button></li>`;
                })
                .join('')}
            </ul>
          </section>`;
        })
        .join('');

      resultsEl.querySelectorAll('[data-slot-start]').forEach((btn) => {
        btn.addEventListener('click', () => {
          selectedSlotStart = (btn as HTMLElement).dataset.slotStart || null;
          resultsEl.querySelectorAll('[data-slot-start]').forEach((other) => {
            other.setAttribute(
              'aria-pressed',
              other === btn ? 'true' : 'false',
            );
          });
        });
      });
    }

    async function loadAvailability() {
      statusEl.textContent = 'Checking the calendar…';
      resultsEl.innerHTML = '';
      showSkeleton(true);
      setLive('loading', 'Connecting to calendar…');
      loadError = null;

      try {
        const res = await fetch('/api/availability', {
          headers: { Accept: 'application/json' },
        });
        const json = (await res.json()) as AvailabilityResponse;

        if (json.ok) {
          data = json;
          fetchedAt = Date.now();
          render({ animateHero: true });
          return;
        }

        if (isLocalHost()) {
          data = buildMockAvailabilityResponse();
          fetchedAt = Date.now();
          render({ animateHero: true });
          return;
        }

        loadError =
          json.message ||
          'Availability is unavailable right now. You can still book a time on Jesse’s scheduling page.';
        data = null;
        renderError();
      } catch {
        if (isLocalHost()) {
          data = buildMockAvailabilityResponse();
          fetchedAt = Date.now();
          render({ animateHero: true });
          return;
        }
        loadError =
          'Availability is unavailable right now. You can still book a time on Jesse’s scheduling page.';
        data = null;
        renderError();
      }
    }

    root.querySelectorAll('.duration-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        setDuration(Number((btn as HTMLElement).dataset.duration));
      });
    });

    root.querySelectorAll('.window-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        windowPreset = ((btn as HTMLElement).dataset.window ||
          'this-week') as WindowPreset;
        setPressed('.window-btn', 'data-window', windowPreset);
        const showCustom = windowPreset === 'custom';
        customWrap.hidden = !showCustom;
        customWrap.classList.toggle('hidden', !showCustom);
        selectedSlotStart = null;
        flashPanel();
        render({ animateHero: true });
      });
    });

    root.querySelectorAll('.tod-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        timeOfDay = ((btn as HTMLElement).dataset.tod || 'all') as TimeOfDayFilter;
        setPressed('.tod-btn', 'data-tod', timeOfDay);
        selectedSlotStart = null;
        flashPanel();
        render();
      });
    });

    rangeStartInput.addEventListener('change', () => {
      if (rangeEndInput.value < rangeStartInput.value) {
        rangeEndInput.value = rangeStartInput.value;
      }
      rangeEndInput.min = rangeStartInput.value;
      if (windowPreset === 'custom') render();
    });

    rangeEndInput.addEventListener('change', () => {
      if (windowPreset === 'custom') render();
    });

    window.addEventListener('keydown', (event) => {
      const target = event.target as HTMLElement | null;
      if (
        target &&
        (target.tagName === 'INPUT' ||
          target.tagName === 'TEXTAREA' ||
          target.isContentEditable)
      ) {
        return;
      }
      const map: Record<string, number> = {
        '1': durations[0],
        '2': durations[1],
        '3': durations[2],
        '4': durations[3],
      };
      const next = map[event.key];
      if (next) {
        event.preventDefault();
        setDuration(next);
      }
    });

    window.setInterval(updateSyncLabel, 30000);
    void loadAvailability();
  }
</script>
