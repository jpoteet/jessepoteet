---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" description="That page is missing." noindex>
  <div class="mx-auto max-w-3xl px-5 py-24 text-center sm:px-8">
    <p class="text-xs font-semibold uppercase tracking-[0.14em] text-[var(--color-sage)]">404</p>
    <h1 class="mt-3 font-display text-4xl font-semibold">That page wandered off</h1>
    <p class="mt-4 text-[var(--color-ink-muted)] dark:text-[var(--color-dark-muted)]">
      Like a fish that got away. Head home, or check the work map. Or just send a note and pretend this never happened.
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href="/" class="btn-primary">Back home</a>
      <a href="/work" class="btn-secondary">See the work</a>
      <a href="/contact" class="btn-secondary">Say hello anyway</a>
    </div>
  </div>
</BaseLayout>
