---
import { getCollection, render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('writing', ({ data }) => data.draft !== true);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout title={post.data.title} description={post.data.description} type="article">
  <article class="mx-auto max-w-3xl px-5 py-14 sm:px-8 sm:py-20">
    <header class="border-b border-[var(--color-line)] pb-8 dark:border-[var(--color-dark-line)]">
      <p class="text-xs font-semibold uppercase tracking-[0.14em] text-[var(--color-sage)] dark:text-[var(--color-dark-muted)]">
        <a href="/writing" class="hover:text-[var(--color-clay)] dark:hover:text-[var(--color-dark-clay)]">Writing</a>
      </p>
      <h1 class="mt-3 font-display text-4xl font-semibold text-balance sm:text-5xl">{post.data.title}</h1>
      <p class="mt-4 text-[var(--color-ink-muted)] dark:text-[var(--color-dark-muted)]">{post.data.description}</p>
      <time
        datetime={post.data.pubDate.toISOString()}
        class="mt-4 block text-sm text-[var(--color-sage)] dark:text-[var(--color-dark-muted)]"
      >
        {
          post.data.pubDate.toLocaleDateString('en-US', {
            year: 'numeric',
            month: 'long',
            day: 'numeric',
          })
        }
      </time>
    </header>

    <div
      class="prose-writing mt-10 space-y-5 text-base leading-relaxed text-[var(--color-ink)] dark:text-[var(--color-dark-ink)] sm:text-lg [&_a]:font-semibold [&_a]:text-[var(--color-clay)] [&_h2]:font-display [&_h2]:text-2xl [&_h2]:font-semibold [&_h2]:pt-4 [&_li]:ml-5 [&_li]:list-disc [&_p]:text-[var(--color-ink-muted)] dark:[&_a]:text-[var(--color-dark-clay)] dark:[&_p]:text-[var(--color-dark-muted)]"
    >
      <Content />
    </div>
  </article>
</BaseLayout>
