---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PhotoSlot from '@/components/PhotoSlot.astro';
import { speakerBios, talkTopics } from '@/config/contact';
---

<BaseLayout
  title="Speaking"
  description="Speaker kit for Jesse Poteet: bios, headshot, talk topics, and booking form."
>
  <article class="site-shell section-pad max-w-3xl">
    <div class="reveal">
      <p class="eyebrow">Speaking</p>
      <h1 class="mt-3 font-display text-4xl font-semibold sm:text-5xl">Speaker kit</h1>
      <p class="mt-4 text-lg text-[var(--color-ink-muted)] dark:text-[var(--color-dark-muted)]">
        For podcast hosts, conference organizers, and teams who want a practical voice on systems, ownership, and getting leaders out of the bottleneck.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/contact?type=podcast" class="btn-primary">Book a podcast guest</a>
        <a href="/contact?type=speaking" class="btn-secondary">Book a speaking engagement</a>
      </div>
    </div>

    <section class="reveal rule mt-14 pt-10">
      <h2 class="font-display text-2xl font-semibold">Headshot</h2>
      <div class="mt-5 max-w-sm">
        <PhotoSlot label="Jesse Poteet headshot" src="/images/photos/jesse-hero.jpg" aspect="square" />
      </div>
      <p class="mt-3 text-sm text-[var(--color-ink-muted)] dark:text-[var(--color-dark-muted)]">
        [JESSE: high-res speaker headshot path if different from site photo]
      </p>
    </section>

    <section class="reveal rule mt-12 pt-10">
      <h2 class="font-display text-2xl font-semibold">Short bio</h2>
      <p class="mt-4 leading-relaxed text-[var(--color-ink-muted)] dark:text-[var(--color-dark-muted)]">
        {speakerBios.short}
      </p>
    </section>

    <section class="reveal rule mt-12 pt-10">
      <h2 class="font-display text-2xl font-semibold">Long bio</h2>
      <div class="mt-4 space-y-4 whitespace-pre-line leading-relaxed text-[var(--color-ink-muted)] dark:text-[var(--color-dark-muted)]">
        {speakerBios.long}
      </div>
    </section>

    <section class="reveal rule mt-12 pt-10">
      <h2 class="font-display text-2xl font-semibold">Talk topics</h2>
      <ul class="mt-6 space-y-0">
        {
          talkTopics.map((topic) => (
            <li class="rule py-5">
              <h3 class="font-display text-xl font-semibold">{topic.title}</h3>
              <p class="mt-2 text-[var(--color-ink-muted)] dark:text-[var(--color-dark-muted)]">{topic.body}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="reveal mt-12 rounded-lg bg-[var(--color-hero)] px-6 py-8 text-[var(--color-hero-ink)]">
      <h2 class="font-display text-2xl font-semibold">Ready to book?</h2>
      <p class="mt-2 text-[var(--color-hero-muted)]">
        Use the contact form with the right request type so the note lands in the right pile.
      </p>
      <div class="mt-5 flex flex-wrap gap-3">
        <a href="/contact?type=podcast" class="btn-on-dark">Podcast guest form</a>
        <a href="/contact?type=speaking" class="btn-on-dark-ghost">Speaking form</a>
        <a href="/contact?type=press" class="btn-on-dark-ghost">Press / media</a>
      </div>
    </section>
  </article>
</BaseLayout>
