---
import AvailabilityLayout from '@/layouts/AvailabilityLayout.astro';
import AvailabilityFinder from '@/components/AvailabilityFinder.astro';
import AvailabilityTools from '@/components/AvailabilityTools.astro';
import { personalAvailability } from '@/config/availability';
import '@/styles/availability-product.css';

const profile = personalAvailability;
---

<AvailabilityLayout title={profile.headline} description={profile.description}>
  <div class="avail-stage" data-avail-stage>
    <div class="avail-camp" data-camp-scene aria-hidden="true">
      <div class="avail-camp-sky" data-camp-sky></div>
      <div class="avail-camp-stars" data-camp-stars data-camp-parallax>
        <span></span><span></span><span></span><span></span><span></span>
        <span></span><span></span><span></span><span></span><span></span>
        <span></span><span></span><span></span><span></span><span></span>
      </div>
      <div class="avail-camp-sun" data-camp-sun></div>
      <div class="avail-camp-moon" data-camp-moon data-camp-parallax></div>

      <svg class="avail-camp-layer avail-camp-ridge-far" data-camp-ridge-far data-camp-parallax viewBox="0 0 1440 420" preserveAspectRatio="xMidYMax slice">
        <path fill="currentColor" d="M0 420V210L120 150l140 90 160-130 180 110 140-80 160 100 150-70 180 90 210-120V420Z" />
        <path fill="var(--camp-snow, #eef3f7)" opacity="0.55" d="M420 110l40 28-18 8-22-20zm340 40l36 24-16 7-20-18zm480-20l42 30-20 8-22-22z" />
      </svg>

      <svg class="avail-camp-layer avail-camp-ridge-mid" data-camp-ridge-mid data-camp-parallax viewBox="0 0 1440 420" preserveAspectRatio="xMidYMax slice">
        <path fill="currentColor" d="M0 420V250L90 200l130 70 120-95 170 100 130-70 190 95 140-55 180 80 140-65 150 70V420Z" />
        <path fill="var(--camp-snow, #eef3f7)" opacity="0.45" d="M340 155l34 26-14 6-20-18zm450 15l38 28-16 7-22-20z" />
      </svg>

      <svg class="avail-camp-layer avail-camp-ridge-near" data-camp-ridge-near data-camp-parallax viewBox="0 0 1440 420" preserveAspectRatio="xMidYMax slice">
        <path fill="currentColor" d="M0 420V300L80 260l110 50 100-70 160 80 120-50 170 70 130-45 180 60 150-40 240 55V420Z" />
      </svg>

      <svg class="avail-camp-layer avail-camp-trees" data-camp-trees data-camp-parallax viewBox="0 0 1440 320" preserveAspectRatio="xMidYMax slice">
        <g fill="currentColor">
          <path d="M40 280l30-90 30 90zm30-55l-12 0 12-36 12 36z" />
          <path d="M110 290l24-70 24 70zm24-42l-10 0 10-28 10 28z" />
          <path d="M190 285l36-100 36 100zm36-60l-14 0 14-40 14 40z" />
          <path d="M280 295l22-65 22 65zm22-38l-9 0 9-26 9 26z" />
          <path d="M1180 288l34-96 34 96zm34-58l-13 0 13-38 13 38z" />
          <path d="M1260 295l26-74 26 74zm26-44l-10 0 10-30 10 30z" />
          <path d="M1340 282l40-110 40 110zm40-66l-15 0 15-44 15 44z" />
          <path d="M980 292l20-58 20 58zm20-34l-8 0 8-22 8 22z" />
          <path d="M1040 298l18-50 18 50zm18-30l-7 0 7-20 7 20z" />
        </g>
      </svg>

      <svg class="avail-camp-layer avail-camp-river" data-camp-river data-camp-parallax viewBox="0 0 1440 220" preserveAspectRatio="xMidYMax slice">
        <path fill="currentColor" opacity="0.72" d="M0 160c180-40 280-20 420 10s280 30 420-10 260-50 420-20 160 40 180 50v90H0Z" />
        <path
          data-camp-river-shine
          fill="none"
          stroke="#cfe3ef"
          stroke-width="2.5"
          stroke-linecap="round"
          opacity="0.45"
          d="M40 168c120-28 220-8 340 12s260 22 380-8 240-42 380-18 220 40 260 48"
        />
      </svg>

      <div class="avail-camp-camp" data-camp-parallax>
        <div class="avail-camp-fire-glow" data-camp-fire-glow></div>
        <svg class="avail-camp-tent" viewBox="0 0 120 80" aria-hidden="true">
          <path fill="currentColor" d="M8 70 L60 12 L112 70 Z" opacity="0.92" />
          <path fill="rgba(0,0,0,0.18)" d="M60 12 L60 70 L112 70 Z" />
          <path fill="none" stroke="rgba(255,255,255,0.2)" stroke-width="1.5" d="M60 18 V68" />
        </svg>
        <svg class="avail-camp-fire" data-camp-fire viewBox="0 0 40 40" aria-hidden="true">
          <ellipse cx="20" cy="30" rx="10" ry="3" fill="rgba(40,28,18,0.45)" />
          <path fill="currentColor" d="M20 8c4 6 10 8 10 14a10 10 0 1 1-20 0c0-6 6-8 10-14z" />
          <path fill="#ffe0a0" opacity="0.85" d="M20 16c2 3 5 4 5 7a5 5 0 1 1-10 0c0-3 3-4 5-7z" />
        </svg>
      </div>
    </div>

    <div class="avail-app-shell">
      <AvailabilityFinder
        durations={profile.durations}
        defaultDuration={profile.defaultDuration}
        headline={profile.headline}
        lead={profile.lead}
      />
    </div>

    <AvailabilityTools />
  </div>
</AvailabilityLayout>

<style is:global>
  @import url('https://fonts.googleapis.com/css2?family=Inter+Tight:wght@600;700;800&family=JetBrains+Mono:wght@400;500;600&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap');
</style>

<script is:inline>
  document.documentElement.classList.remove('dark');
</script>

<script is:inline>
  (function () {
    function clock(zone) {
      return new Intl.DateTimeFormat('en-US', {
        timeZone: zone,
        hour: 'numeric',
        minute: '2-digit',
      }).format(new Date());
    }
    function tickClocks() {
      var mtEl = document.querySelector('[data-clock-mt]');
      if (mtEl) mtEl.textContent = clock('America/Denver');
    }
    tickClocks();
    setInterval(tickClocks, 30000);
  })();
</script>

<script>
  const scene = document.querySelector('[data-camp-scene]') as HTMLElement | null;
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (scene) {
    const boot = () => {
      void import('@/lib/availability/campingScene').then(({ createCampingScene }) => {
        const handle = createCampingScene(scene, { reducedMotion: reduce });
        window.addEventListener('pagehide', () => handle.destroy(), { once: true });
      });
    };
    if ('requestIdleCallback' in window) {
      (window as Window & { requestIdleCallback: (cb: () => void) => number }).requestIdleCallback(boot, {
        timeout: 900,
      } as IdleRequestOptions);
    } else {
      window.setTimeout(boot, 120);
    }
  }
</script>
