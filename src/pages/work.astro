---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PrintProGroup from '@/components/PrintProGroup.astro';
import { alpineApparel, operatorStack } from '@/config/brands';
---

<BaseLayout
  title="Work"
  description="Ventures and brands from Jesse Poteet: Alpine Apparel Co, Operator Stack, and PrintPro Strategies (education and software)."
>
  <div class="mx-auto max-w-5xl px-5 py-14 sm:px-8 sm:py-20">
    <header class="max-w-2xl">
      <p class="text-xs font-semibold uppercase tracking-[0.14em] text-[var(--color-sage)] dark:text-[var(--color-dark-muted)]">
        Work / Ventures
      </p>
      <h1 class="mt-3 font-display text-4xl font-semibold sm:text-5xl">What I am building</h1>
      <p class="mt-4 text-lg text-[var(--color-ink-muted)] dark:text-[var(--color-dark-muted)]">
        Alpine and Operator Stack stand alone. Print education and print-shop software sit under PrintPro Strategies. Each one exists to solve a specific owner problem.
      </p>
    </header>

    <section id="alpine" class="scroll-mt-24 border-t border-[var(--color-line)] pt-12 mt-12 dark:border-[var(--color-dark-line)]">
      <h2 class="font-display text-2xl font-semibold sm:text-3xl">{alpineApparel.name}</h2>
      <p class="mt-2 max-w-2xl text-[var(--color-ink-muted)] dark:text-[var(--color-dark-muted)]">
        <span class="font-semibold text-[var(--color-ink)] dark:text-[var(--color-dark-ink)]">Problem:</span>
        {alpineApparel.problem}
      </p>
      <p class="mt-3 max-w-2xl text-sm text-[var(--color-ink-muted)] dark:text-[var(--color-dark-muted)]">{alpineApparel.blurb}</p>
      <p class="mt-4">
        <a href={alpineApparel.url!} class="text-sm font-semibold text-[var(--color-clay)] dark:text-[var(--color-dark-clay)]" rel="noopener noreferrer">
          alpineapparelco.com →
        </a>
      </p>
    </section>

    <section id="systems" class="scroll-mt-24 border-t border-[var(--color-line)] pt-12 mt-12 dark:border-[var(--color-dark-line)]">
      <h2 class="font-display text-2xl font-semibold sm:text-3xl">{operatorStack.name}</h2>
      <p class="mt-2 max-w-2xl text-[var(--color-ink-muted)] dark:text-[var(--color-dark-muted)]">
        <span class="font-semibold text-[var(--color-ink)] dark:text-[var(--color-dark-ink)]">Problem:</span>
        {operatorStack.problem}
      </p>
      <p class="mt-3 max-w-2xl text-sm text-[var(--color-ink-muted)] dark:text-[var(--color-dark-muted)]">{operatorStack.blurb}</p>
      <p class="mt-4 flex flex-wrap gap-4">
        <a href={operatorStack.url!} class="text-sm font-semibold text-[var(--color-clay)] dark:text-[var(--color-dark-clay)]" rel="noopener noreferrer">
          operatorstack.io →
        </a>
        <a href="/contact?type=operator-stack" class="text-sm font-semibold text-[var(--color-clay)] dark:text-[var(--color-dark-clay)]">
          Request a free 30-minute process review →
        </a>
      </p>
    </section>

    <section class="scroll-mt-24 border-t border-[var(--color-line)] pt-12 mt-12 dark:border-[var(--color-dark-line)]">
      <h2 class="font-display text-2xl font-semibold sm:text-3xl">PrintPro Strategies</h2>
      <p class="mt-2 max-w-2xl text-[var(--color-ink-muted)] dark:text-[var(--color-dark-muted)]">
        Parent company for print education brands and software built for print shops.
      </p>
      <div class="mt-8">
        <PrintProGroup />
      </div>
    </section>

    <p class="mt-14 text-sm text-[var(--color-ink-muted)] dark:text-[var(--color-dark-muted)]">
      Logos are placeholders for now. Drop files under
      <code class="rounded bg-[var(--color-photo-slot)] px-1.5 py-0.5 text-xs dark:bg-[var(--color-dark-elevated)]">public/images/logos/</code>.
    </p>
  </div>
</BaseLayout>
