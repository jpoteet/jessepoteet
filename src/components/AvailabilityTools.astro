---

<section class="avail-tools" aria-label="Tools I build with">
  <p class="avail-tools-label">Tools I build with</p>
  <div class="avail-marquee">
    <div class="avail-marquee-track">
      {
        loop.map((tool, i) => (
          <div
            class="avail-tool"
            style={`--brand: ${tool.color}`}
            title={tool.name}
            aria-hidden={i >= tools.length ? 'true' : undefined}
          >
            <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
              <path fill="currentColor" d={tool.path} />
            </svg>
            <span>{tool.name}</span>
          </div>
        ))
      }
    </div>
  </div>
  <ul class="sr-only">
    {tools.map((tool) => <li>{tool.name}</li>)}
  </ul>
</section>
