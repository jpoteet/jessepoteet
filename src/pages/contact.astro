---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ContactForm from '@/components/ContactForm.astro';
import { SITE, NEWSLETTER_URL } from '@/config/site';
import { socialLinks, isPlaceholderUrl } from '@/config/social';
import { workWithMePaths } from '@/config/contact';

const typeParam = Astro.url.searchParams.get('type');
---

<BaseLayout
  title="Work with me"
  description="Contact Jesse Poteet for podcasts, speaking, Operator Stack projects, or press."
>
  <div class="mx-auto max-w-3xl px-5 py-14 sm:px-8 sm:py-20">
    <header>
      <p class="text-xs font-semibold uppercase tracking-[0.14em] text-[var(--color-sage)] dark:text-[var(--color-dark-muted)]">
        Contact
      </p>
      <h1 class="mt-3 font-display text-4xl font-semibold sm:text-5xl">Work with me</h1>
      <p class="mt-4 text-lg text-[var(--color-ink-muted)] dark:text-[var(--color-dark-muted)]">
        Tell me what you are putting together. Podcasts, talks, Operator Stack projects, and press all start here.
      </p>
    </header>

    <div class="mt-8 grid gap-4 sm:grid-cols-3">
      {
        workWithMePaths.map((path) => (
          <a
            href={path.href}
            class="border-t border-[var(--color-line)] pt-4 text-sm dark:border-[var(--color-dark-line)]"
            rel={'external' in path && path.external ? 'noopener noreferrer' : undefined}
          >
            <span class="font-display text-base font-semibold">{path.title}</span>
          </a>
        ))
      }
    </div>

    <div class="relative mt-12 border-t border-[var(--color-line)] pt-10 dark:border-[var(--color-dark-line)]">
      <ContactForm initialType={typeParam} />
    </div>

    <div class="mt-14 space-y-6 border-t border-[var(--color-line)] pt-8 text-sm text-[var(--color-ink-muted)] dark:border-[var(--color-dark-line)] dark:text-[var(--color-dark-muted)]">
      <p>
        Prefer email?
        <a class="font-semibold text-[var(--color-clay)] dark:text-[var(--color-dark-clay)]" href={SITE.emailMailto}>
          {SITE.emailDisplay}
        </a>
      </p>
      <p>
        Newsletter:
        <a class="font-semibold text-[var(--color-clay)] dark:text-[var(--color-dark-clay)]" href={NEWSLETTER_URL} rel="noopener noreferrer">
          news.startupscreenprinting.com
        </a>
      </p>
      <ul class="space-y-1">
        {
          socialLinks.map((link) => (
            <li>
              {isPlaceholderUrl(link.href) ? (
                <>
                  {link.label}: {link.href}
                </>
              ) : (
                <a href={link.href} class="font-semibold text-[var(--color-clay)] dark:text-[var(--color-dark-clay)]" rel="noopener noreferrer">
                  {link.label}
                </a>
              )}
            </li>
          ))
        }
      </ul>
      <p class="text-xs opacity-80">
        Speaker kit and bios live on the <a class="underline" href="/speaking">Speaking</a> page. Prefill this form with
        <code class="rounded bg-[var(--color-photo-slot)] px-1 dark:bg-[var(--color-dark-elevated)]">?type=podcast</code>,
        <code class="rounded bg-[var(--color-photo-slot)] px-1 dark:bg-[var(--color-dark-elevated)]">speaking</code>,
        <code class="rounded bg-[var(--color-photo-slot)] px-1 dark:bg-[var(--color-dark-elevated)]">operator-stack</code>,
        <code class="rounded bg-[var(--color-photo-slot)] px-1 dark:bg-[var(--color-dark-elevated)]">press</code>, or
        <code class="rounded bg-[var(--color-photo-slot)] px-1 dark:bg-[var(--color-dark-elevated)]">other</code>.
      </p>
    </div>
  </div>
</BaseLayout>
