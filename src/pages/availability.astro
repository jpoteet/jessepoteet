---
import BaseLayout from '@/layouts/BaseLayout.astro';
import AvailabilityFinder from '@/components/AvailabilityFinder.astro';
import { personalAvailability } from '@/config/availability';

const profile = personalAvailability;
---

<BaseLayout title={profile.headline} description={profile.description}>
  <div class="relative overflow-hidden">
    <div
      class="pointer-events-none absolute inset-0 -z-10 bg-[radial-gradient(ellipse_at_top,_rgba(31,61,50,0.08),_transparent_55%),linear-gradient(180deg,_#f3f5f2_0%,_var(--color-canvas)_42%)] dark:bg-[radial-gradient(ellipse_at_top,_rgba(143,186,159,0.12),_transparent_50%),linear-gradient(180deg,_#121612_0%,_var(--color-dark-canvas)_45%)]"
      aria-hidden="true"
    ></div>

    <article class="site-shell section-pad max-w-3xl">
      <header class="reveal">
        <p class="eyebrow">{profile.eyebrow}</p>
        <h1 class="mt-3 font-display text-4xl font-semibold sm:text-5xl">
          <span class="block text-[var(--color-accent)] dark:text-[var(--color-dark-accent)]">
            {profile.displayName}
          </span>
          <span class="mt-2 block">{profile.headline}</span>
        </h1>
        <p class="mt-5 max-w-2xl text-lg leading-relaxed text-[var(--color-ink-muted)] dark:text-[var(--color-dark-muted)]">
          {profile.lead}
        </p>
      </header>

      <div class="reveal reveal-delay-1 mt-12">
        <AvailabilityFinder
          bookingUrl={profile.bookingUrl}
          bookingCta={profile.bookingCta}
          durations={profile.durations}
          defaultDuration={profile.defaultDuration}
        />
      </div>
    </article>
  </div>
</BaseLayout>
