---
import { alpineQuoteProof } from '@/config/expertise';
---

<figure class="panel p-6 sm:p-8">
  <figcaption class="eyebrow">A story from the floor</figcaption>
  <p class="mt-3 font-display text-2xl font-semibold text-balance sm:text-3xl">
    {alpineQuoteProof.headline}
  </p>
  <p class="mt-4 text-[var(--color-ink-muted)] dark:text-[var(--color-dark-muted)]">
    {alpineQuoteProof.story}
  </p>

  <div class="mt-8 space-y-5" role="img" aria-label="Visual comparison of quote effort before and after">
    <div>
      <p class="mb-2 text-sm font-medium text-[var(--color-ink-muted)] dark:text-[var(--color-dark-muted)]">
        {alpineQuoteProof.beforeLabel}
      </p>
      <div class="h-2.5 overflow-hidden rounded-sm bg-[var(--color-line)] dark:bg-[var(--color-dark-line)]">
        <div
          class="h-full rounded-sm bg-[var(--color-ink-muted)] dark:bg-[var(--color-dark-muted)]"
          style={`width: ${alpineQuoteProof.beforeWidth}%`}
        >
        </div>
      </div>
    </div>
    <div>
      <p class="mb-2 text-sm font-medium text-[var(--color-ink-muted)] dark:text-[var(--color-dark-muted)]">
        {alpineQuoteProof.afterLabel}
      </p>
      <div class="h-2.5 overflow-hidden rounded-sm bg-[var(--color-line)] dark:bg-[var(--color-dark-line)]">
        <div
          class="h-full rounded-sm bg-[var(--color-accent)] dark:bg-[var(--color-dark-accent)]"
          style={`width: ${alpineQuoteProof.afterWidth}%`}
        >
        </div>
      </div>
    </div>
  </div>
</figure>
