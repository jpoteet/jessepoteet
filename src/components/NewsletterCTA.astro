---
import { NEWSLETTER_URL } from '@/config/site';

interface Props {
  heading?: string;
  body?: string;
}

const {
  heading = 'Practical notes for owners who want off the treadmill',
  body = 'Published through Startup Screen Printing. Useful if you run a shop, a crew, or any owner-led business that still depends on you for everything.',
} = Astro.props;
---

<aside class="rounded-lg bg-[var(--color-hero)] px-6 py-10 text-[var(--color-hero-ink)] sm:px-10">
  <div class="max-w-xl">
    <h2 class="font-display text-2xl font-semibold sm:text-3xl">{heading}</h2>
    <p class="mt-3 text-base leading-relaxed text-[var(--color-hero-muted)]">{body}</p>
    <a href={NEWSLETTER_URL} class="btn-on-dark mt-6" rel="noopener noreferrer">
      Jump on the list
      <span class="ml-2" aria-hidden="true">→</span>
    </a>
  </div>
</aside>
