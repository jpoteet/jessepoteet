---
import { BOOKING_LINKS, personalAvailability } from '@/config/availability';

interface Props {
  durations?: readonly number[];
  defaultDuration?: number;
  headline?: string;
  lead?: string;
}

const {
  durations = personalAvailability.durations,
  defaultDuration = personalAvailability.defaultDuration,
  headline = personalAvailability.headline,
  lead = personalAvailability.lead,
} = Astro.props;

const defaultIndex = Math.max(0, durations.indexOf(defaultDuration));

const placeholders = [
  '30 minutes sometime in the next 3 weeks',
  'an hour next Tuesday afternoon',
  'quick 15 min call tomorrow morning',
  'anything Friday',
];
---

<div
  id="availability-finder"
  class="availability-finder avail-app-grid"
  data-booking-links={JSON.stringify(BOOKING_LINKS)}
  data-default-duration={String(defaultDuration)}
  data-durations={JSON.stringify(durations)}
  data-placeholders={JSON.stringify(placeholders)}
>
  <header class="avail-top">
    <form class="avail-ask-hero" data-ask-form>
      <h1 class="avail-ask-title">When works for you?</h1>
      <div class="avail-ask-row">
        <input
          id="avail-ask-input"
          class="avail-ask-input"
          type="text"
          autocomplete="off"
          spellcheck="false"
          maxlength="300"
          placeholder={placeholders[0]}
          data-ask-input
          aria-label="When works for you"
        />
        <button type="submit" class="avail-ask-go" data-ask-go>Find it</button>
      </div>
      <p class="avail-ask-reply" data-ask-reply hidden></p>
      <p class="avail-ask-msg" data-ask-msg hidden></p>
      <div class="avail-ask-chips" data-ask-chips hidden></div>
    </form>

    <div class="avail-meta-row" aria-live="polite">
      <p class="avail-live-line" data-live data-state="loading">
        <span class="avail-live-dot" aria-hidden="true"></span>
        <span data-live-label>Connecting…</span>
        <span class="avail-live-sep" aria-hidden="true">·</span>
        <span>times in <span data-zone-chip>…</span></span>
        <span class="avail-chip-book" data-booking-badge hidden> · booking on</span>
      </p>
      <p class="avail-next-mini" data-hero>
        <span data-tminus>opens in --</span>
        <span data-next-opening>Loading…</span>
        <span class="avail-next-meta" data-next-meta hidden></span>
      </p>
    </div>

    <div class="avail-adjust-bar">
      <div
        class="avail-adjust-group"
        role="group"
        aria-label="Meeting length"
        data-duration-segment
        style={`--seg-count: ${durations.length}; --seg-index: ${defaultIndex};`}
      >
        {
          durations.map((mins, i) => (
            <button
              type="button"
              class={`duration-btn avail-pill avail-chip-tone avail-chip-tone-${i % 8}`}
              data-duration={mins}
              data-index={i}
              aria-pressed={mins === defaultDuration ? 'true' : 'false'}
            >
              {mins}m
            </button>
          ))
        }
      </div>
      <div class="avail-adjust-group" role="group" aria-label="Week">
        <button type="button" class="avail-pill avail-chip-tone avail-chip-tone-0 window-btn" data-window="this-week" aria-pressed="true">This week</button>
        <button type="button" class="avail-pill avail-chip-tone avail-chip-tone-4 window-btn" data-window="next-week" aria-pressed="false">Next week</button>
      </div>
      <div class="avail-adjust-group" role="group" aria-label="Time of day">
        <button type="button" class="avail-pill avail-chip-tone avail-chip-tone-5 tod-btn" data-tod="all" aria-pressed="true">All</button>
        <button type="button" class="avail-pill avail-chip-tone avail-chip-tone-3 tod-btn" data-tod="morning" aria-pressed="false">AM</button>
        <button type="button" class="avail-pill avail-chip-tone avail-chip-tone-1 tod-btn" data-tod="afternoon" aria-pressed="false">PM</button>
      </div>
      <div class="avail-adjust-wrap">
        <button type="button" class="avail-adjust-toggle" data-adjust-toggle aria-expanded="false">Adjust</button>
        <div class="avail-adjust-panel" data-adjust-panel hidden>
          <button type="button" class="avail-pill avail-chip-tone avail-chip-tone-7 window-btn" data-window="custom" aria-pressed="false">Custom range</button>
          <div id="custom-range" class="avail-date-grid" data-custom-range hidden>
            <label class="avail-date-field">
              <span>From</span>
              <input type="date" id="range-start" />
            </label>
            <label class="avail-date-field">
              <span>Through</span>
              <input type="date" id="range-end" />
            </label>
          </div>
          <div class="avail-book-footer" data-book-footer hidden>
            <p class="avail-pick-note" data-pick-note hidden></p>
            <a href="#" class="avail-cta" rel="noopener noreferrer" target="_blank" data-book-btn>
              Book a time <span aria-hidden="true">↗</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </header>

  <section class="avail-workspace" aria-label="Open times">
    <div class="avail-workspace-bar">
      <div class="avail-cal-nav">
        <button type="button" class="avail-cal-nav-btn" data-week-prev aria-label="Previous week">‹</button>
        <div class="avail-cal-nav-center">
          <p class="avail-cal-week-label" data-week-label>This week</p>
          <p class="avail-status" data-status>Checking the calendar…</p>
        </div>
        <button type="button" class="avail-cal-nav-btn" data-week-next aria-label="Next week">›</button>
      </div>
      <div class="avail-cal-jump" data-week-jump aria-label="Jump to a week"></div>
    </div>
    <div class="avail-skeleton" data-skeleton hidden>
      <div class="avail-skel-line lg"></div>
      <div class="avail-skel-line" style="width: 70%;"></div>
    </div>
    <div id="slot-results" class="avail-board avail-cal-board" data-results></div>
  </section>
</div>

<script>
  import { buildMockAvailabilityResponse } from '@/lib/availability/mock';
  import { parseAvailabilityAsk } from '@/lib/availability/parseQuery';
  import {
    filterByTimeOfDay,
    generateSlots,
    nextDateWithRoom,
    nextOpening,
  } from '@/lib/availability/slots';
  import {
    addDaysInZone,
    dateKeyInZone,
    detectVisitorTimeZone,
    formatShortDate,
    formatTimeInZone,
    friendlyZoneName,
    parseInstant,
    startOfDayInZone,
    startOfWeekMondayInZone,
    weekdayInZone,
    zonedLocalToUtc,
  } from '@/lib/availability/time';
  import type {
    AvailabilityResponse,
    AvailabilitySuccess,
    TimeOfDayFilter,
    WindowPreset,
  } from '@/lib/availability/types';

  function escapeHtml(value: string) {
    return value
      .replaceAll('&', '&amp;')
      .replaceAll('<', '&lt;')
      .replaceAll('>', '&gt;')
      .replaceAll('"', '&quot;');
  }

  function isLocalHost() {
    const host = window.location.hostname;
    return host === 'localhost' || host === '127.0.0.1';
  }

  /** Dev-only mock slots for local screenshots. Never on by default in production. */
  function allowMockSlots() {
    if (isLocalHost()) return true;
    const params = new URLSearchParams(window.location.search);
    if (params.get('mock') !== '1') return false;
    // Preview hosts only. Production domain stays find/API-only.
    const host = window.location.hostname;
    return host.endsWith('.pages.dev') || host === '127.0.0.1' || host === 'localhost';
  }

  /** Mock screenshots should show Mountain Time open hours (9am–2pm MT). */
  function resolveVisitorZone() {
    if (allowMockSlots()) return 'America/Denver';
    return detectVisitorTimeZone();
  }

  function prefersReducedMotion() {
    return window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  }

  const root = document.getElementById('availability-finder');
  if (root) {
    const durations = JSON.parse(root.dataset.durations || '[15,30,60,90]') as number[];
    const placeholders = JSON.parse(root.dataset.placeholders || '[]') as string[];
    const defaultDuration = Number(root.dataset.defaultDuration || 30);
    const bookingLinks = JSON.parse(root.dataset.bookingLinks || '{}') as Record<string, string>;
    const bookParam = new URLSearchParams(window.location.search).get('book');
    const bookingCode =
      bookParam == null ? '' : bookParam.trim().toLowerCase();
    const bookingUrl = bookingCode ? bookingLinks[bookingCode] || '' : '';
    const bookingEnabled = Boolean(bookingUrl);
    let duration = defaultDuration;
    let windowPreset: WindowPreset = 'this-week';
    let timeOfDay: TimeOfDayFilter = 'all';
    let data: AvailabilitySuccess | null = null;
    let loadError: string | null = null;
    let fetchedAt: number | null = null;
    let selectedSlotStart: string | null = null;
    let nextOpeningIso: string | null = null;
    let heroAnimToken = 0;
    let viewMonday = startOfWeekMondayInZone(new Date(), resolveVisitorZone());
    let mobileDayKey = dateKeyInZone(new Date(), resolveVisitorZone());
    let highlightStarts = new Set<string>();
    let preferredDays: string[] = [];
    let asking = false;
    const visitorZone = resolveVisitorZone();

    const statusEl = root.querySelector('[data-status]') as HTMLElement;
    const weekLabelEl = root.querySelector('[data-week-label]') as HTMLElement | null;
    const weekJumpEl = root.querySelector('[data-week-jump]') as HTMLElement | null;
    const resultsEl = root.querySelector('[data-results]') as HTMLElement;
    const nextEl = root.querySelector('[data-next-opening]') as HTMLElement;
    const nextMetaEl = root.querySelector('[data-next-meta]') as HTMLElement;
    const tminusEl = root.querySelector('[data-tminus]') as HTMLElement;
    const liveEl = root.querySelector('[data-live]') as HTMLElement;
    const liveLabelEl = root.querySelector('[data-live-label]') as HTMLElement;
    const zoneChipEl = root.querySelector('[data-zone-chip]') as HTMLElement;
    const skeletonEl = root.querySelector('[data-skeleton]') as HTMLElement;
    const customWrap = root.querySelector('[data-custom-range]') as HTMLElement;
    const durationSegment = root.querySelector('[data-duration-segment]') as HTMLElement;
    const rangeStartInput = root.querySelector('#range-start') as HTMLInputElement;
    const rangeEndInput = root.querySelector('#range-end') as HTMLInputElement;
    const askForm = root.querySelector('[data-ask-form]') as HTMLFormElement;
    const askInput = root.querySelector('[data-ask-input]') as HTMLInputElement;
    const askGo = root.querySelector('[data-ask-go]') as HTMLButtonElement | null;
    const askChips = root.querySelector('[data-ask-chips]') as HTMLElement;
    const askReply = root.querySelector('[data-ask-reply]') as HTMLElement;
    const askMsg = root.querySelector('[data-ask-msg]') as HTMLElement;
    const pickNoteEl = root.querySelector('[data-pick-note]') as HTMLElement | null;
    const bookBtn = root.querySelector('[data-book-btn]') as HTMLAnchorElement | null;
    const bookFooter = root.querySelector('[data-book-footer]') as HTMLElement | null;
    const bookingBadge = root.querySelector('[data-booking-badge]') as HTMLElement | null;
    const adjustToggle = root.querySelector('[data-adjust-toggle]') as HTMLButtonElement | null;
    const adjustPanel = root.querySelector('[data-adjust-panel]') as HTMLElement | null;

    if (bookingEnabled && bookingUrl) {
      if (bookFooter) bookFooter.hidden = false;
      if (bookingBadge) bookingBadge.hidden = false;
      if (bookBtn) bookBtn.href = bookingUrl;
    }

    function unavailableMessage() {
      if (bookingEnabled && bookingUrl) {
        return 'Availability is unavailable right now. You can still book a time with the button below.';
      }
      return 'Availability is unavailable right now. Try again in a few minutes.';
    }

    function updatePickNote() {
      if (!pickNoteEl || !bookingEnabled) return;
      if (!selectedSlotStart) {
        pickNoteEl.hidden = true;
        pickNoteEl.textContent = '';
        return;
      }
      const label = formatTimeInZone(parseInstant(selectedSlotStart), visitorZone);
      pickNoteEl.textContent = `Pick ${label} on the next page.`;
      pickNoteEl.hidden = false;
    }

    function selectSlot(start: string | null) {
      selectedSlotStart = start;
      resultsEl.querySelectorAll('[data-slot-start]').forEach((other) => {
        const el = other as HTMLElement;
        other.setAttribute('aria-pressed', el.dataset.slotStart === start ? 'true' : 'false');
      });
      updatePickNote();
    }

    zoneChipEl.textContent = friendlyZoneName(visitorZone);

    const todayKey = dateKeyInZone(new Date(), visitorZone);
    rangeStartInput.min = todayKey;
    rangeEndInput.min = todayKey;
    rangeStartInput.value = todayKey;
    rangeEndInput.value = dateKeyInZone(
      addDaysInZone(startOfDayInZone(new Date(), visitorZone), 6, visitorZone),
      visitorZone,
    );

    // Rotating ask placeholders
    if (placeholders.length && !prefersReducedMotion()) {
      let pi = 0;
      window.setInterval(() => {
        if (document.activeElement === askInput || askInput.value) return;
        pi = (pi + 1) % placeholders.length;
        askInput.placeholder = placeholders[pi];
      }, 3800);
    }

    function setPressed(selector: string, attr: string, value: string) {
      root!.querySelectorAll(selector).forEach((btn) => {
        const el = btn as HTMLElement;
        el.setAttribute('aria-pressed', el.getAttribute(attr) === value ? 'true' : 'false');
      });
    }

    function flashPanel() {
      if (prefersReducedMotion()) return;
      root!.dataset.flash = 'false';
      void root!.offsetWidth;
      root!.dataset.flash = 'true';
      window.setTimeout(() => {
        root!.dataset.flash = 'false';
      }, 480);
    }

    function setDuration(next: number, opts: { animate?: boolean } = {}) {
      if (!durations.includes(next)) return;
      duration = next;
      durationSegment.style.setProperty('--seg-index', String(durations.indexOf(next)));
      setPressed('.duration-btn', 'data-duration', String(duration));
      selectedSlotStart = null;
      if (opts.animate !== false) flashPanel();
      render({ animateHero: true });
    }

    type AskApiResult = {
      ok: boolean;
      duration?: number;
      rangeStart?: string;
      rangeEnd?: string;
      timeOfDay?: 'any' | 'morning' | 'afternoon';
      preferredDays?: string[];
      reply?: string;
      source?: 'ai' | 'local';
      message?: string;
    };

    function applyLocalAsk(raw: string): AskApiResult {
      const parsed = parseAvailabilityAsk(raw, {
        visitorTimeZone: visitorZone,
        durations,
      });
      if (!parsed.ok) {
        return { ok: false, message: parsed.message };
      }
      return {
        ok: true,
        duration: parsed.durationMinutes,
        rangeStart: parsed.rangeStartKey,
        rangeEnd: parsed.rangeEndKey,
        timeOfDay:
          parsed.timeOfDay === 'all'
            ? 'any'
            : (parsed.timeOfDay as 'morning' | 'afternoon'),
        reply: `Got it: ${parsed.summary}.`,
        source: 'local',
      };
    }

    function applyAskResult(result: AskApiResult) {
      if (!result.ok) {
        askChips.hidden = true;
        askChips.innerHTML = '';
        askReply.hidden = true;
        askReply.textContent = '';
        askMsg.hidden = false;
        askMsg.textContent = result.message || 'Could not understand that ask.';
        return;
      }

      askMsg.hidden = true;
      askReply.hidden = false;
      askReply.textContent = result.reply || 'Here is what I found.';

      const chips: { kind: string; label: string }[] = [
        { kind: 'duration', label: `${result.duration || duration} min` },
      ];
      if (result.rangeStart && result.rangeEnd) {
        chips.push({
          kind: 'window',
          label:
            result.rangeStart === result.rangeEnd
              ? result.rangeStart
              : `${result.rangeStart} to ${result.rangeEnd}`,
        });
      }
      if (result.timeOfDay && result.timeOfDay !== 'any') {
        chips.push({
          kind: 'tod',
          label: result.timeOfDay === 'morning' ? 'Morning' : 'Afternoon',
        });
      }
      askChips.hidden = false;
      askChips.innerHTML = chips
        .map(
          (chip) =>
            `<button type="button" class="avail-ask-chip" data-chip-kind="${chip.kind}">${escapeHtml(chip.label)} <span aria-hidden="true">×</span></button>`,
        )
        .join('');

      setDuration(Number(result.duration || duration), { animate: false });
      timeOfDay =
        !result.timeOfDay || result.timeOfDay === 'any'
          ? 'all'
          : (result.timeOfDay as TimeOfDayFilter);
      setPressed('.tod-btn', 'data-tod', timeOfDay);

      preferredDays = (result.preferredDays || []).map((d) => d.toLowerCase().slice(0, 3));
      windowPreset = 'custom';
      setPressed('.window-btn', 'data-window', 'custom');
      customWrap.hidden = false;
      customWrap.classList.remove('hidden');
      openAdjust(true);
      if (result.rangeStart) rangeStartInput.value = result.rangeStart;
      if (result.rangeEnd) rangeEndInput.value = result.rangeEnd || result.rangeStart || rangeEndInput.value;
      if (result.rangeStart) {
        viewMonday = startOfWeekMondayInZone(
          parseInstant(`${result.rangeStart}T17:00:00.000Z`),
          visitorZone,
        );
        mobileDayKey = result.rangeStart;
      }

      askChips.querySelectorAll('[data-chip-kind]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const kind = (btn as HTMLElement).dataset.chipKind;
          if (kind === 'tod') {
            timeOfDay = 'all';
            setPressed('.tod-btn', 'data-tod', 'all');
          } else if (kind === 'window') {
            windowPreset = 'this-week';
            setPressed('.window-btn', 'data-window', 'this-week');
            customWrap.hidden = true;
            customWrap.classList.add('hidden');
            preferredDays = [];
            highlightStarts = new Set();
          }
          btn.remove();
          if (!askChips.children.length) askChips.hidden = true;
          flashPanel();
          render({ animateHero: true });
        });
      });

      flashPanel();
      render({ animateHero: true, markBest: true });
    }

    async function applyAsk(raw: string) {
      const text = raw.trim().slice(0, 300);
      if (!text || asking) return;
      asking = true;
      if (askGo) {
        askGo.disabled = true;
        askGo.textContent = 'Finding…';
      }
      askMsg.hidden = true;
      askReply.hidden = true;

      let result: AskApiResult | null = null;
      try {
        const res = await fetch('/api/ask', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({
            text,
            timeZone: visitorZone,
            today: dateKeyInZone(new Date(), visitorZone),
            durations,
          }),
        });
        result = (await res.json()) as AskApiResult;
      } catch {
        result = null;
      }

      if (!result || result.ok === false) {
        // Always keep the page working: local parser fallback.
        result = applyLocalAsk(text);
        if (!result.ok && result.message) {
          // keep message
        } else if (result.ok && !result.reply) {
          result.reply = 'Here is what I found.';
        }
      }

      applyAskResult(result);
      asking = false;
      if (askGo) {
        askGo.disabled = false;
        askGo.textContent = 'Find it';
      }
    }

    function windowExclusiveEnd(now = new Date()): Date {
      if (windowPreset === 'custom' && rangeEndInput.value) {
        const endStart = startOfDayInZone(
          parseInstant(`${rangeEndInput.value}T17:00:00.000Z`),
          visitorZone,
        );
        return addDaysInZone(endStart, 1, visitorZone);
      }
      const monday = startOfWeekMondayInZone(now, visitorZone);
      if (windowPreset === 'this-week') return addDaysInZone(monday, 7, visitorZone);
      return addDaysInZone(monday, 14, visitorZone);
    }

    function updateTminus() {
      if (!nextOpeningIso) {
        tminusEl.textContent = 'opens in --';
        return;
      }
      const ms = parseInstant(nextOpeningIso).getTime() - Date.now();
      if (ms <= 0) {
        tminusEl.textContent = 'open now';
        return;
      }
      const totalMin = Math.floor(ms / 60000);
      const days = Math.floor(totalMin / (60 * 24));
      const hours = Math.floor((totalMin % (60 * 24)) / 60);
      const mins = totalMin % 60;
      if (days >= 2) {
        tminusEl.textContent = `opens in ${days} days`;
      } else if (days === 1) {
        tminusEl.textContent =
          hours > 0 ? `opens in 1 day ${hours}h` : 'opens in 1 day';
      } else if (hours >= 1) {
        tminusEl.textContent =
          mins > 0 ? `opens in ${hours}h ${mins}m` : `opens in ${hours}h`;
      } else {
        tminusEl.textContent = `opens in ${Math.max(mins, 1)} min`;
      }
    }

    function setLive(state: 'loading' | 'live' | 'error', label: string) {
      liveEl.dataset.state = state;
      liveLabelEl.textContent = label;
    }

    function openAdjust(open: boolean) {
      if (!adjustPanel || !adjustToggle) return;
      adjustPanel.hidden = !open;
      adjustToggle.setAttribute('aria-expanded', open ? 'true' : 'false');
    }

    function showSkeleton(show: boolean) {
      skeletonEl.hidden = !show;
      if (show) resultsEl.innerHTML = '';
    }

    function renderError() {
      nextEl.textContent = 'Unavailable right now';
      nextMetaEl.textContent = '';
      nextOpeningIso = null;
      updateTminus();
      resultsEl.innerHTML = '';
      showSkeleton(false);
      setLive('error', 'Availability is unavailable right now');
      statusEl.innerHTML = `<div class="avail-empty"><strong>Availability is unavailable right now</strong>${escapeHtml(
        loadError || unavailableMessage(),
      )}</div>`;
    }

    function renderHero(openingText: string, metaText: string, animate: boolean) {
      const token = ++heroAnimToken;
      if (animate && !prefersReducedMotion()) {
        nextEl.dataset.animate = 'false';
        void nextEl.offsetWidth;
        nextEl.dataset.animate = 'true';
      } else {
        nextEl.dataset.animate = 'false';
      }
      nextEl.textContent = openingText;
      nextMetaEl.textContent = metaText;
      window.setTimeout(() => {
        if (token === heroAnimToken) nextEl.dataset.animate = 'false';
      }, 500);
    }

    function weekDays(monday: Date) {
      return [0, 1, 2, 3, 4].map((i) => addDaysInZone(monday, i, visitorZone));
    }

    function syncViewFromPreset() {
      const now = new Date();
      if (windowPreset === 'this-week') {
        viewMonday = startOfWeekMondayInZone(now, visitorZone);
      } else if (windowPreset === 'next-week') {
        viewMonday = addDaysInZone(startOfWeekMondayInZone(now, visitorZone), 7, visitorZone);
      } else if (rangeStartInput.value) {
        viewMonday = startOfWeekMondayInZone(
          parseInstant(`${rangeStartInput.value}T17:00:00.000Z`),
          visitorZone,
        );
      }
    }

    function updateWeekChrome() {
      const days = weekDays(viewMonday);
      const startLabel = formatShortDate(days[0], visitorZone);
      const endLabel = formatShortDate(days[4], visitorZone);
      if (weekLabelEl) weekLabelEl.textContent = `${startLabel} – ${endLabel}`;

      if (weekJumpEl) {
        const nowMon = startOfWeekMondayInZone(new Date(), visitorZone);
        const jumps = [0, 1, 2, 3].map((i) => addDaysInZone(nowMon, i * 7, visitorZone));
        weekJumpEl.innerHTML = jumps
          .map((mon) => {
            const key = dateKeyInZone(mon, visitorZone);
            const active = dateKeyInZone(viewMonday, visitorZone) === key;
            const label = new Intl.DateTimeFormat('en-US', {
              timeZone: visitorZone,
              month: 'short',
              day: 'numeric',
            }).format(mon);
            return `<button type="button" class="avail-cal-jump-btn${active ? ' is-active' : ''}" data-jump-monday="${key}">Week of ${escapeHtml(label)}</button>`;
          })
          .join('');
        weekJumpEl.querySelectorAll('[data-jump-monday]').forEach((btn) => {
          btn.addEventListener('click', () => {
            const key = (btn as HTMLElement).dataset.jumpMonday || '';
            viewMonday = startOfWeekMondayInZone(
              parseInstant(`${key}T17:00:00.000Z`),
              visitorZone,
            );
            windowPreset = 'custom';
            setPressed('.window-btn', 'data-window', 'custom');
            customWrap.hidden = false;
            customWrap.classList.remove('hidden');
            const fri = addDaysInZone(viewMonday, 4, visitorZone);
            rangeStartInput.value = dateKeyInZone(viewMonday, visitorZone);
            rangeEndInput.value = dateKeyInZone(fri, visitorZone);
            flashPanel();
            render();
          });
        });
      }
    }

    function markBestSlots(slots: { start: string }[]) {
      highlightStarts = new Set();
      const ranked = [...slots];
      ranked.sort((a, b) => {
        const wa = weekdayInZone(parseInstant(a.start), visitorZone);
        const wb = weekdayInZone(parseInstant(b.start), visitorZone);
        const names = ['sun', 'mon', 'tue', 'wed', 'thu', 'fri', 'sat'];
        const pa = preferredDays.includes(names[wa]) ? 0 : 1;
        const pb = preferredDays.includes(names[wb]) ? 0 : 1;
        if (pa !== pb) return pa - pb;
        return a.start.localeCompare(b.start);
      });
      ranked.slice(0, Math.min(4, ranked.length)).forEach((s) => highlightStarts.add(s.start));
    }

    function hostMinutesOf(slotStart: string) {
      const parts = new Intl.DateTimeFormat('en-US', {
        timeZone: data!.meta.timeZone,
        hour: '2-digit',
        minute: '2-digit',
        hourCycle: 'h23',
      }).formatToParts(parseInstant(slotStart));
      const h = Number(parts.find((p) => p.type === 'hour')?.value || 0);
      const m = Number(parts.find((p) => p.type === 'minute')?.value || 0);
      return h * 60 + m;
    }

    function slotButtonHtml(
      slot: { start: string; durationMinutes: number },
      tone: number,
      opts: { delay?: number; gridRow?: string; compact?: boolean } = {},
    ) {
      const label = formatTimeInZone(parseInstant(slot.start), visitorZone);
      const pressed = selectedSlotStart === slot.start ? 'true' : 'false';
      const best = highlightStarts.has(slot.start) ? ' is-best' : '';
      const styleBits = [
        opts.delay ? `animation-delay: ${opts.delay}s` : '',
        opts.gridRow ? `grid-row: ${opts.gridRow}` : '',
      ]
        .filter(Boolean)
        .join('; ');
      const book =
        bookingEnabled && bookingUrl
          ? `<a class="avail-slot-book" href="${escapeHtml(bookingUrl)}" target="_blank" rel="noopener noreferrer" data-book-slot="${escapeHtml(slot.start)}">Book</a>`
          : '';
      const btn = `<button type="button" class="avail-slot avail-chip-tone-${tone}${best}" data-slot-start="${escapeHtml(slot.start)}" aria-pressed="${pressed}">${escapeHtml(label)}</button>`;
      return `<div class="avail-slot-wrap" style="${styleBits}">${btn}${book}</div>`;
    }

    function render(opts: { animateHero?: boolean; markBest?: boolean } = {}) {
      if (!data) {
        renderError();
        return;
      }

      showSkeleton(false);
      setLive('live', "Live from Jesse's calendar");

      const opening = nextOpening(data.busy, data.meta, duration);
      if (opening) {
        const start = parseInstant(opening.start);
        nextOpeningIso = opening.start;
        renderHero(
          `${formatShortDate(start, visitorZone)} · ${formatTimeInZone(start, visitorZone)}`,
          `${duration} min · ${friendlyZoneName(visitorZone)}`,
          !!opts.animateHero,
        );
      } else {
        nextOpeningIso = null;
        renderHero(`No openings for ${duration} min`, 'in the next few weeks', !!opts.animateHero);
      }
      updateTminus();

      if (windowPreset !== 'custom') syncViewFromPreset();
      updateWeekChrome();

      const weekEnd = addDaysInZone(viewMonday, 4, visitorZone);
      const weekStartKey = dateKeyInZone(viewMonday, visitorZone);
      const weekEndKey = dateKeyInZone(weekEnd, visitorZone);

      // Filter range: intersection of UI filters and visible week for the grid,
      // but status count uses the full filter window.
      const query =
        windowPreset === 'custom'
          ? {
              durationMinutes: duration,
              visitorTimeZone: visitorZone,
              rangeStartKey: rangeStartInput.value,
              rangeEndKey: rangeEndInput.value,
            }
          : {
              durationMinutes: duration,
              visitorTimeZone: visitorZone,
              preset: windowPreset,
            };

      let allSlots = generateSlots(data.busy, data.meta, query);
      allSlots = filterByTimeOfDay(allSlots, visitorZone, timeOfDay);

      const weekSlots = allSlots.filter((s) => {
        const key = dateKeyInZone(parseInstant(s.start), visitorZone);
        return key >= weekStartKey && key <= weekEndKey;
      });

      if (opts.markBest) {
        markBestSlots(allSlots);
      }

      const days = weekDays(viewMonday);
      const dayKeys = days.map((d) => dateKeyInZone(d, visitorZone));
      if (!dayKeys.includes(mobileDayKey)) mobileDayKey = dayKeys[0];

      const hostZone = data.meta.timeZone;
      const ticks: number[] = [];
      for (
        let m = data.meta.openHours.startMinutes;
        m < data.meta.openHours.endMinutes;
        m += data.meta.slotIntervalMinutes
      ) {
        ticks.push(m);
      }

      const byDay = new Map<string, typeof weekSlots>();
      for (const key of dayKeys) byDay.set(key, []);
      for (const slot of weekSlots) {
        const key = dateKeyInZone(parseInstant(slot.start), visitorZone);
        byDay.get(key)?.push(slot);
      }

      statusEl.innerHTML = `<span class="avail-status-count">${allSlots.length}</span> open · week grid in ${escapeHtml(friendlyZoneName(visitorZone))} · Jesse 9am–2pm MT`;

      if (!allSlots.length) {
        const hint = nextDateWithRoom(
          data.busy,
          data.meta,
          duration,
          visitorZone,
          windowExclusiveEnd(),
        );
        let detail = 'Nothing open in that window.';
        if (hint) detail += ` The next day with room is ${hint.label}.`;
        statusEl.innerHTML = `<div class="avail-empty"><strong>Quiet for that filter</strong>${escapeHtml(detail)}</div>`;
      }

      const dayHeads = days
        .map((d, i) => {
          const key = dayKeys[i];
          const label = new Intl.DateTimeFormat('en-US', {
            timeZone: visitorZone,
            weekday: 'short',
            month: 'short',
            day: 'numeric',
          }).format(d);
          const count = byDay.get(key)?.length || 0;
          return `<div class="avail-cal-dayhead" data-day-key="${key}"><span>${escapeHtml(label)}</span><em>${count}</em></div>`;
        })
        .join('');

      const labelParts = new Intl.DateTimeFormat('en-CA', {
        timeZone: hostZone,
        year: 'numeric',
        month: '2-digit',
        day: '2-digit',
      }).formatToParts(days[0]);
      const labelY = Number(labelParts.find((p) => p.type === 'year')?.value || 0);
      const labelMo = Number(labelParts.find((p) => p.type === 'month')?.value || 0);
      const labelD = Number(labelParts.find((p) => p.type === 'day')?.value || 0);
      const interval = data.meta.slotIntervalMinutes;

      const timeCol = ticks
        .map((hostMinutes) => {
          const timeLabel = formatTimeInZone(
            zonedLocalToUtc(labelY, labelMo, labelD, hostMinutes, hostZone),
            visitorZone,
          );
          return `<div class="avail-cal-time">${escapeHtml(timeLabel)}</div>`;
        })
        .join('');

      const dayCols = dayKeys
        .map((key, dayIndex) => {
          const tone = dayIndex % 8;
          const daySlots = byDay.get(key) || [];
          const occupied = new Set<number>();
          const blocks: string[] = [];

          for (const slot of daySlots) {
            const startM = hostMinutesOf(slot.start);
            const tickIdx = ticks.indexOf(startM);
            if (tickIdx < 0) continue;
            const span = Math.max(1, Math.round(slot.durationMinutes / interval));
            const safeSpan = Math.min(span, ticks.length - tickIdx);
            for (let s = 0; s < safeSpan; s++) occupied.add(tickIdx + s);
            blocks.push(
              slotButtonHtml(slot, tone, {
                gridRow: `${tickIdx + 1} / span ${safeSpan}`,
              }),
            );
          }

          const empties = ticks
            .map((_, i) =>
              occupied.has(i)
                ? ''
                : `<div class="avail-cal-cell" style="grid-row: ${i + 1}"><span class="avail-cal-empty" aria-hidden="true"></span></div>`,
            )
            .join('');

          return `<div class="avail-cal-daycol" data-day-key="${key}">${empties}${blocks.join('')}</div>`;
        })
        .join('');

      const mobileSlots = byDay.get(mobileDayKey) || [];
      const mobileTone = Math.max(0, dayKeys.indexOf(mobileDayKey)) % 8;
      const mobileStrip = days
        .map((d, i) => {
          const key = dayKeys[i];
          const short = new Intl.DateTimeFormat('en-US', {
            timeZone: visitorZone,
            weekday: 'short',
          }).format(d);
          const num = new Intl.DateTimeFormat('en-US', {
            timeZone: visitorZone,
            day: 'numeric',
          }).format(d);
          const count = byDay.get(key)?.length || 0;
          const active = key === mobileDayKey ? ' is-active' : '';
          return `<button type="button" class="avail-cal-mobile-day${active}" data-mobile-day="${key}"><span>${escapeHtml(short)}</span><strong>${escapeHtml(num)}</strong><em>${count}</em></button>`;
        })
        .join('');

      resultsEl.className = 'avail-board avail-cal-board';
      resultsEl.innerHTML = `
        <div class="avail-cal" data-cal>
          <div class="avail-cal-desktop" aria-hidden="false">
            <div class="avail-cal-grid" style="--tick-count: ${ticks.length}">
              <div class="avail-cal-corner" aria-hidden="true"></div>
              ${dayHeads}
              <div class="avail-cal-times">${timeCol}</div>
              ${dayCols}
            </div>
          </div>
          <div class="avail-cal-mobile">
            <div class="avail-cal-mobile-strip">${mobileStrip}</div>
            <div class="avail-cal-mobile-list">
              ${
                mobileSlots.length
                  ? mobileSlots
                      .map((slot, i) =>
                        slotButtonHtml(slot, mobileTone, {
                          delay: Math.min(i, 12) * 0.028,
                          compact: true,
                        }),
                      )
                      .join('')
                  : '<div class="avail-empty"><strong>No opens this day</strong>Try another weekday in this week.</div>'
              }
            </div>
          </div>
        </div>`;

      resultsEl.querySelectorAll('[data-slot-start]').forEach((btn) => {
        btn.addEventListener('click', () => {
          selectSlot((btn as HTMLElement).dataset.slotStart || null);
        });
      });
      resultsEl.querySelectorAll('[data-book-slot]').forEach((link) => {
        link.addEventListener('click', () => {
          selectSlot((link as HTMLElement).dataset.bookSlot || null);
        });
      });
      resultsEl.querySelectorAll('[data-mobile-day]').forEach((btn) => {
        btn.addEventListener('click', () => {
          mobileDayKey = (btn as HTMLElement).dataset.mobileDay || mobileDayKey;
          render();
        });
      });

      updatePickNote();
    }

    function attachTilt() {
      if (prefersReducedMotion()) return;
      root!.querySelectorAll('.avail-tilt-card').forEach((card) => {
        const el = card as HTMLElement;
        el.onpointermove = (e) => {
          const r = el.getBoundingClientRect();
          const px = (e.clientX - r.left) / r.width - 0.5;
          const py = (e.clientY - r.top) / r.height - 0.5;
          el.style.transform = `perspective(900px) rotateX(${(-py * 4).toFixed(2)}deg) rotateY(${(px * 5).toFixed(2)}deg) translateY(-1px)`;
        };
        el.onpointerleave = () => {
          el.style.transform = '';
        };
      });
    }

    // Panel tilt
    if (!prefersReducedMotion()) {
      root.addEventListener('pointermove', (e) => {
        const r = root.getBoundingClientRect();
        const px = (e.clientX - r.left) / r.width - 0.5;
        const py = (e.clientY - r.top) / r.height - 0.5;
        root.style.setProperty('--tilt-x', `${(-py * 1.4).toFixed(3)}deg`);
        root.style.setProperty('--tilt-y', `${(px * 1.8).toFixed(3)}deg`);
      });
      root.addEventListener('pointerleave', () => {
        root.style.setProperty('--tilt-x', '0deg');
        root.style.setProperty('--tilt-y', '0deg');
      });
    }

    async function loadAvailability() {
      statusEl.textContent = 'Checking the calendar…';
      resultsEl.innerHTML = '';
      showSkeleton(true);
      setLive('loading', 'Connecting…');
      loadError = null;
      try {
        const res = await fetch('/api/availability', { headers: { Accept: 'application/json' } });
        const json = (await res.json()) as AvailabilityResponse;
        if (json.ok) {
          data = json;
          fetchedAt = Date.now();
          render({ animateHero: true });
          return;
        }
        if (allowMockSlots()) {
          data = buildMockAvailabilityResponse();
          fetchedAt = Date.now();
          render({ animateHero: true });
          return;
        }
        loadError = json.message || unavailableMessage();
        data = null;
        renderError();
      } catch {
        if (allowMockSlots()) {
          data = buildMockAvailabilityResponse();
          fetchedAt = Date.now();
          render({ animateHero: true });
          return;
        }
        loadError = unavailableMessage();
        data = null;
        renderError();
      }
    }

    askForm.addEventListener('submit', (e) => {
      e.preventDefault();
      void applyAsk(askInput.value);
    });

    askInput.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' && !e.shiftKey) {
        e.preventDefault();
        void applyAsk(askInput.value);
      }
    });

    root.querySelector('[data-week-prev]')?.addEventListener('click', () => {
      viewMonday = addDaysInZone(viewMonday, -7, visitorZone);
      windowPreset = 'custom';
      setPressed('.window-btn', 'data-window', 'custom');
      customWrap.hidden = false;
      customWrap.classList.remove('hidden');
      rangeStartInput.value = dateKeyInZone(viewMonday, visitorZone);
      rangeEndInput.value = dateKeyInZone(addDaysInZone(viewMonday, 4, visitorZone), visitorZone);
      selectedSlotStart = null;
      flashPanel();
      render();
    });

    root.querySelector('[data-week-next]')?.addEventListener('click', () => {
      viewMonday = addDaysInZone(viewMonday, 7, visitorZone);
      windowPreset = 'custom';
      setPressed('.window-btn', 'data-window', 'custom');
      customWrap.hidden = false;
      customWrap.classList.remove('hidden');
      rangeStartInput.value = dateKeyInZone(viewMonday, visitorZone);
      rangeEndInput.value = dateKeyInZone(addDaysInZone(viewMonday, 4, visitorZone), visitorZone);
      selectedSlotStart = null;
      flashPanel();
      render();
    });

    root.querySelectorAll('.duration-btn').forEach((btn) => {
      btn.addEventListener('click', () => setDuration(Number((btn as HTMLElement).dataset.duration)));
    });

    root.querySelectorAll('.window-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        windowPreset = ((btn as HTMLElement).dataset.window || 'this-week') as WindowPreset;
        setPressed('.window-btn', 'data-window', windowPreset);
        const showCustom = windowPreset === 'custom';
        customWrap.hidden = !showCustom;
        customWrap.classList.toggle('hidden', !showCustom);
        if (showCustom) openAdjust(true);
        preferredDays = [];
        highlightStarts = new Set();
        selectedSlotStart = null;
        syncViewFromPreset();
        flashPanel();
        render({ animateHero: true });
      });
    });

    root.querySelectorAll('.tod-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        timeOfDay = ((btn as HTMLElement).dataset.tod || 'all') as TimeOfDayFilter;
        setPressed('.tod-btn', 'data-tod', timeOfDay);
        selectedSlotStart = null;
        flashPanel();
        render();
      });
    });

    rangeStartInput.addEventListener('change', () => {
      if (rangeEndInput.value < rangeStartInput.value) rangeEndInput.value = rangeStartInput.value;
      rangeEndInput.min = rangeStartInput.value;
      if (windowPreset === 'custom') render();
    });
    rangeEndInput.addEventListener('change', () => {
      if (windowPreset === 'custom') render();
    });

    window.addEventListener('keydown', (event) => {
      const target = event.target as HTMLElement | null;
      if (target && (target.tagName === 'INPUT' || target.tagName === 'TEXTAREA' || target.isContentEditable)) {
        return;
      }
      const map: Record<string, number> = {
        '1': durations[0],
        '2': durations[1],
        '3': durations[2],
        '4': durations[3],
      };
      if (map[event.key]) {
        event.preventDefault();
        setDuration(map[event.key]);
      }
    });

    if (bookBtn && bookingEnabled) {
      bookBtn.addEventListener('click', () => {
        updatePickNote();
      });
    }

    adjustToggle?.addEventListener('click', () => {
      openAdjust(adjustPanel?.hidden !== false);
    });

    document.addEventListener('click', (e) => {
      if (!adjustPanel || adjustPanel.hidden) return;
      const t = e.target as Node;
      if (adjustPanel.contains(t) || adjustToggle?.contains(t)) return;
      openAdjust(false);
    });

    window.setInterval(updateTminus, 1000);
    void loadAvailability();
  }
</script>
